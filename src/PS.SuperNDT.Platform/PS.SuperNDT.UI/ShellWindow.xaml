<Window x:Class="PS.SuperNDT.UI.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PS.SuperNDT.UI.Controls"
        Title="PS SuperNDT Platform"
        Height="900"
        Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="#1B1D22">

    <DockPanel LastChildFill="True">

        <!-- HEADER -->

        <Border DockPanel.Dock="Top"
                Height="60"
                Background="#222831">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <TextBlock Margin="20,0"
                           VerticalAlignment="Center"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           Text="PS SuperNDT Platform"/>

                <TextBlock Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="15"
                           Foreground="White"
                           Text="{Binding CurrentTime}"/>

            </Grid>

        </Border>

        <!-- MAIN MENU -->

        <controls:MainMenu DockPanel.Dock="Top"/>

        <!-- STATUS BAR -->

        <StatusBar DockPanel.Dock="Bottom"
                   Height="30">

            <StatusBarItem Content="🟢 Detector Ready"/>
            <StatusBarItem Content="🟡 PLC Offline"/>
            <StatusBarItem Content="🟢 Database"/>
            <StatusBarItem Content="🟢 License"/>
            <StatusBarItem Content="🟢 Calculator Ready"/>

        </StatusBar>

        <!-- MAIN BODY -->

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT MENU -->

            <Border Grid.Column="0"
                    Background="#252830">

                <ItemsControl ItemsSource="{Binding MenuItems}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Button Height="45"
                                    Margin="5"
                                    Content="{Binding Title}"
                                    Command="{Binding DataContext.NavigateCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </Border>

            <!-- PAGE CONTENT -->

            <Border Grid.Column="1"
                    Background="#1F232A">

                <ContentControl Content="{Binding CurrentPage}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>

            </Border>

        </Grid>

    </DockPanel>

</Window>