<Window x:Class="PS.SuperNDT.UI.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PS SuperNDT Platform"
        Height="900"
        Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="#1B1D22">

    <DockPanel>

        <!-- HEADER -->

        <Border DockPanel.Dock="Top"
                Height="60"
                Background="#222831">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Margin="20,0"
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="PS SuperNDT Platform"/>

                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="15"
                    Foreground="White"
                    Text="{Binding CurrentTime}"/>

            </Grid>

        </Border>


        <!-- STATUS BAR -->

        <StatusBar DockPanel.Dock="Bottom"
                   Height="30">

            <StatusBarItem Content="🟢 Detector Ready"/>
            <StatusBarItem Content="🟡 PLC Offline"/>
            <StatusBarItem Content="🟢 Database"/>
            <StatusBarItem Content="🟢 License"/>
            <StatusBarItem Content="🟢 Calculator Ready"/>

        </StatusBar>


        <!-- BODY -->

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>


            <!-- MENU -->

            <Border Background="#252830">

                <ItemsControl ItemsSource="{Binding MenuItems}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Button
                                Height="45"
                                Margin="5"
                                Content="{Binding Title}"
                                Command="{Binding DataContext.NavigateCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </Border>


            <!-- CONTENT -->

            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentPage}"/>

        </Grid>

    </DockPanel>

</Window>