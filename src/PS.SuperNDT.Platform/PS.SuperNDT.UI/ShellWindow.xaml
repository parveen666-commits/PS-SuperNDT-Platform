<Window x:Class="PS.SuperNDT.UI.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PS.SuperNDT.UI.Controls"
        Title="PS SuperNDT Platform"
        Height="900"
        Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="#1B1D22">

    <Window.Resources>

        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="#252A33"/>
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="BorderBrush" Value="#3A404C"/>
            <Setter Property="BorderThickness" Value="1,1,0,0"/>
        </Style>

        <Style TargetType="StatusBarItem">
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2D3440"/>
            <Setter Property="BorderBrush" Value="#3D4552"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0E639C"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- HEADER -->

        <Border DockPanel.Dock="Top"
                Height="60"
                Background="#222831">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <TextBlock Margin="20,0"
                           VerticalAlignment="Center"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           Text="PS SuperNDT Platform"/>

                <TextBlock Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="15"
                           Foreground="White"
                           Text="{Binding CurrentTime}"/>

            </Grid>

        </Border>

        <!-- TOP MENU -->

        <controls:MainMenu DockPanel.Dock="Top"/>

        <!-- STATUS BAR -->

        <StatusBar DockPanel.Dock="Bottom"
                   Height="30">

            <StatusBarItem Content="🟢 Detector Ready"/>
            <StatusBarItem Content="🟡 PLC Offline"/>
            <StatusBarItem Content="🟢 Database"/>
            <StatusBarItem Content="🟢 License"/>
            <StatusBarItem Content="🟢 Calculator Ready"/>

        </StatusBar>

        <!-- MAIN BODY -->

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION -->

            <Border Grid.Column="0"
                    Background="#252830"
                    BorderBrush="#353B45"
                    BorderThickness="0,0,1,0">

                <ItemsControl ItemsSource="{Binding MenuItems}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Button Style="{StaticResource NavigationButtonStyle}"
                                    Content="{Binding Title}"
                                    Command="{Binding DataContext.NavigateCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </Border>

            <!-- PAGE CONTENT -->

            <Border Grid.Column="1"
                    Background="#1F232A">

                <ContentControl Content="{Binding CurrentPage}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>

            </Border>

        </Grid>

    </DockPanel>

</Window>