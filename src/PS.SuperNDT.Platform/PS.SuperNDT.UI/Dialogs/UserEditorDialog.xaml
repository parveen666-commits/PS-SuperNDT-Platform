<Window x:Class="PS.SuperNDT.UI.Dialogs.UserEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Editor"
        Height="520"
        Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1F232A">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="8">

            <TextBlock Text="User Account"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

        </Border>

        <!-- User Details -->

        <Border Grid.Row="1"
                Margin="0,15,0,15"
                Padding="20"
                Background="#252B33"
                CornerRadius="8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="55"/>
                </Grid.RowDefinitions>

                <!-- Username -->

                <TextBlock Grid.Row="0"
                           Text="Username"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontSize="15"/>

                <TextBox x:Name="UsernameTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Height="35"
                         VerticalContentAlignment="Center"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Full Name -->

                <TextBlock Grid.Row="1"
                           Text="Full Name"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontSize="15"/>

                <TextBox x:Name="FullNameTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Height="35"
                         VerticalContentAlignment="Center"
                         Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Password -->

                <TextBlock Grid.Row="2"
                           Text="Password"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontSize="15"/>

                <PasswordBox x:Name="PasswordTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Height="35"
                             VerticalContentAlignment="Center"/>

                <!-- Role -->

                <TextBlock Grid.Row="3"
                           Text="Role"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontSize="15"/>

                <ComboBox x:Name="RoleComboBox"
                          Grid.Row="3"
                          Grid.Column="1"
                          Height="35"
                          VerticalContentAlignment="Center">

                    <ComboBoxItem Content="Operator"/>
                    <ComboBoxItem Content="LevelII"/>
                    <ComboBoxItem Content="LevelIII"/>
                    <ComboBoxItem Content="Admin"/>

                </ComboBox>

                <!-- Active -->

                <TextBlock Grid.Row="4"
                           Text="Account Status"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontSize="15"/>

                <CheckBox x:Name="ActiveCheckBox"
                          Grid.Row="4"
                          Grid.Column="1"
                          Content="Active"
                          IsChecked="True"
                          Foreground="White"
                          VerticalAlignment="Center"
                          FontSize="15"/>

            </Grid>

        </Border>

        <!-- Footer -->

        <Border Grid.Row="2"
                Background="#252B33"
                CornerRadius="8">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="10">

                <Button Width="120"
                        Height="40"
                        Margin="5"
                        Content="Save"
                        Click="Save_Click"/>

                <Button Width="120"
                        Height="40"
                        Margin="5"
                        Content="Cancel"
                        Click="Cancel_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>