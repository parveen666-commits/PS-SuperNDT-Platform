<Window x:Class="PS.SuperNDT.UI.Dialogs.JobDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Job"
        Height="650"
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1F232A">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <Border Background="#252B33"
                CornerRadius="8">

            <TextBlock Text="Create New Inspection Job"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

        </Border>

        <!-- Job Details -->

        <Grid Grid.Row="1"
              Margin="0,20,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Job Number -->

            <TextBlock Text="Job Number"/>

            <TextBox Grid.Column="1"
                     Text="{Binding JobNumber, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Customer -->

            <TextBlock Grid.Row="1"
                       Text="Customer"/>

            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Text="{Binding Customer, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Project -->

            <TextBlock Grid.Row="2"
                       Text="Project"/>

            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Text="{Binding Project, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Component -->

            <TextBlock Grid.Row="3"
                       Text="Component"/>

            <TextBox Grid.Row="3"
                     Grid.Column="1"
                     Text="{Binding Component, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Weld Number -->

            <TextBlock Grid.Row="4"
                       Text="Weld Number"/>

            <TextBox Grid.Row="4"
                     Grid.Column="1"
                     Text="{Binding WeldNumber, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Operator -->

            <TextBlock Grid.Row="5"
                       Text="Operator"/>

            <TextBox Grid.Row="5"
                     Grid.Column="1"
                     Text="{Binding Operator, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Procedure -->

            <TextBlock Grid.Row="6"
                       Text="Procedure"/>

            <TextBox Grid.Row="6"
                     Grid.Column="1"
                     Text="{Binding Procedure, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Material -->

            <TextBlock Grid.Row="7"
                       Text="Material"/>

            <TextBox Grid.Row="7"
                     Grid.Column="1"
                     Text="{Binding Material, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Remarks -->

            <TextBlock Grid.Row="8"
                       Margin="0,8,0,0"
                       VerticalAlignment="Top"
                       Text="Remarks"/>

            <TextBox Grid.Row="8"
                     Grid.Column="1"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"/>

        </Grid>

        <!-- Footer -->

        <Border Grid.Row="2"
                Background="#252B33"
                CornerRadius="8">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="10">

                <Button Width="120"
                        Content="Save"
                        Click="Save_Click"/>

                <Button Width="120"
                        Margin="10,0,0,0"
                        Content="Cancel"
                        Click="Cancel_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>