<Window x:Class="PS.SuperNDT.UI.Dialogs.OpenJobDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Job"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#1F232A">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="6">

            <TextBlock Text="Open Existing Job"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

        </Border>

        <!-- Search -->

        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Background="#252B33"
                CornerRadius="6">

            <Grid Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Search"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Height="28"
                         VerticalContentAlignment="Center"/>

            </Grid>

        </Border>

        <!-- Job List -->

        <Border Grid.Row="2"
                Margin="0,10,0,10"
                Background="#252B33"
                CornerRadius="6">

            <DataGrid x:Name="JobsGrid"
                      Margin="10"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Job Number"
                                        Binding="{Binding JobNumber}"
                                        Width="160"/>

                    <DataGridTextColumn Header="Customer"
                                        Binding="{Binding Customer}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Project"
                                        Binding="{Binding Project}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Component"
                                        Binding="{Binding Component}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Operator"
                                        Binding="{Binding Operator}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Created"
                                        Binding="{Binding CreatedOn}"
                                        Width="180"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- Footer -->

        <Border Grid.Row="3"
                Background="#252B33"
                CornerRadius="6">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="10">

                <Button x:Name="OpenButton"
                        Width="120"
                        Height="40"
                        Margin="5"
                        Content="Open"/>

                <Button x:Name="CancelButton"
                        Width="120"
                        Height="40"
                        Margin="5"
                        Content="Cancel"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>