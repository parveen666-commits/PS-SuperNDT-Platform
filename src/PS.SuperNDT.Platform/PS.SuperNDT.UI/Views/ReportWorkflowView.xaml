<UserControl x:Class="PS.SuperNDT.UI.Views.ReportWorkflowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="8">

            <TextBlock Text="Report Workflow"
                       Margin="20,0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"/>

        </Border>


        <Border Grid.Row="1"
                Margin="0,15,0,0"
                Background="#252B33"
                CornerRadius="8"
                Padding="20">

            <StackPanel>


                <TextBlock Text="Current Report"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"/>


                <TextBlock Text="{Binding CurrentReport.ReportNumber}"
                           Foreground="White"
                           Margin="0,15,0,0"/>


                <TextBlock Text="{Binding CurrentReport.Customer}"
                           Foreground="White"
                           Margin="0,5,0,0"/>


                <StackPanel Orientation="Horizontal"
                            Margin="0,30,0,0">


                    <Button Content="Create Report"
                            Width="140"
                            Height="35"
                            Margin="5"
                            Click="CreateReport_Click"/>


                    <Button Content="Submit Approval"
                            Width="160"
                            Height="35"
                            Margin="5"
                            Click="SubmitApproval_Click"/>


                </StackPanel>


                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="White"
                           FontSize="16"
                           Margin="5,25,0,0"/>


            </StackPanel>


        </Border>


    </Grid>

</UserControl>