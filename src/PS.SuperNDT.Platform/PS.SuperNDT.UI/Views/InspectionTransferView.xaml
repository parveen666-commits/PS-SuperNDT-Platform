<UserControl x:Class="PS.SuperNDT.UI.Views.InspectionTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Background="#1F232A">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Margin="15"
                CornerRadius="8"
                Background="#2B313A">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center"
                            Margin="20,0">

                    <TextBlock Text="Inspection Transfer Engine"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="Auto / Manual Transfer Queue"
                               Foreground="#AEB6C2"
                               FontSize="13"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Margin="10"
                        Content="Manual Send"
                        Command="{Binding ManualSendCommand}"/>

                <ToggleButton Grid.Column="2"
                              Margin="10"
                              Content="Auto Transfer"
                              IsChecked="{Binding AutoTransferEnabled}"/>
            </Grid>

        </Border>

        <Border Grid.Row="1"
                Margin="15,0,15,15"
                Padding="15"
                Background="#2B313A"
                CornerRadius="8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Destination"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="14"/>

                <TextBox Grid.Column="1"
                         Height="32"
                         Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

        </Border>

        <Border Grid.Row="2"
                Margin="15,0,15,15"
                Background="#2B313A"
                CornerRadius="8">

            <DataGrid ItemsSource="{Binding Queue}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Margin="10">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Job"
                                        Binding="{Binding JobNumber}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Inspection"
                                        Binding="{Binding InspectionNumber}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Image"
                                        Binding="{Binding ImagePath}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Destination"
                                        Binding="{Binding Destination}"
                                        Width="220"/>

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Created"
                                        Binding="{Binding CreatedOn}"
                                        Width="160"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>