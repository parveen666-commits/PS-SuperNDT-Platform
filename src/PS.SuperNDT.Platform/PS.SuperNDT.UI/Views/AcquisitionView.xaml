<UserControl x:Class="PS.SuperNDT.UI.Views.AcquisitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="8">

            <Grid Margin="15,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="430"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Acquisition"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding ShotPosition}"
                               Foreground="#00E5FF"
                               FontSize="12"
                               Margin="0,2,0,0"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <TextBlock Text="WORK ORDER: "
                                   Foreground="#B0BEC5"
                                   FontSize="11"/>

                        <TextBlock Text="{Binding CurrentWorkOrder, Mode=OneWay}"
                                   Foreground="#00E5FF"
                                   FontSize="13"
                                   FontWeight="Bold"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,2,0,0">

                        <TextBlock Text="{Binding DetectorStatus}"
                                   Foreground="Orange"
                                   FontSize="12"/>

                        <TextBlock Text="   "
                                   Foreground="#B0BEC5"/>

                        <TextBlock Text="{Binding AcquisitionStatus}"
                                   Foreground="#B0BEC5"
                                   FontSize="11"/>

                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>

        <!-- MAIN -->

        <Grid Grid.Row="1"
              Margin="0,8">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="245"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="245"/>

            </Grid.ColumnDefinitions>

            <!-- LEFT -->

            <Border Grid.Column="0"
                    Background="#252B33"
                    CornerRadius="8"
                    Margin="0,0,8,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="12">

                        <TextBlock Text="Job / Work Order"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Work Order"
                                   Foreground="#B0BEC5"
                                   FontSize="11"
                                   Margin="0,14,0,4"/>

                        <TextBox Height="30"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 Text="{Binding CurrentWorkOrder, Mode=OneWay}"/>

                        <TextBlock Text="Current Job"
                                   Foreground="#B0BEC5"
                                   FontSize="11"
                                   Margin="0,10,0,4"/>

                        <TextBox Height="30"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 Text="{Binding CurrentJob, Mode=OneWay}"/>

                        <TextBlock Text="Pipe ID"
                                   Foreground="#B0BEC5"
                                   FontSize="11"
                                   Margin="0,10,0,4"/>

                        <TextBox Height="30"
                                 FontSize="12"
                                 Text="{Binding PipeId, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Enter Pipe ID / Pipe Number"/>

                        <Separator Margin="0,14"/>

                        <TextBlock Text="Shot Planning"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Pipe Length (mm)"
                                   Foreground="#B0BEC5"
                                   FontSize="11"
                                   Margin="0,12,0,4"/>

                        <TextBox Height="30"
                                 FontSize="12"
                                 Text="{Binding PipeLength, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="DR Shot Size (mm)"
                                   Foreground="#B0BEC5"
                                   FontSize="11"
                                   Margin="0,10,0,4"/>

                        <TextBox Height="30"
                                 FontSize="12"
                                 Text="{Binding ShotSize, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Overlap (mm)"
                                   Foreground="#B0BEC5"
                                   FontSize="11"
                                   Margin="0,10,0,4"/>

                        <TextBox Height="30"
                                 FontSize="12"
                                 Text="{Binding Overlap, UpdateSourceTrigger=PropertyChanged}"/>

                        <Separator Margin="0,14"/>

                        <TextBlock Text="Exposure"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                        <TextBlock Text="kV"
                                   Foreground="#B0BEC5"
                                   FontSize="11"
                                   Margin="0,12,0,4"/>

                        <TextBox Height="30"
                                 FontSize="12"
                                 Text="{Binding KV, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="mA"
                                   Foreground="#B0BEC5"
                                   FontSize="11"
                                   Margin="0,10,0,4"/>

                        <TextBox Height="30"
                                 FontSize="12"
                                 Text="{Binding MA, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Exposure Time"
                                   Foreground="#B0BEC5"
                                   FontSize="11"
                                   Margin="0,10,0,4"/>

                        <TextBox Height="30"
                                 FontSize="12"
                                 Text="{Binding ExposureTime, UpdateSourceTrigger=PropertyChanged}"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

            <!-- RT IMAGE AREA -->

            <Border Grid.Column="1"
                    Background="Black"
                    BorderBrush="#404040"
                    BorderThickness="1"
                    CornerRadius="8">

                <Grid>

                    <!-- CLEAN RT IMAGE -->

                    <Image Source="{Binding CapturedImageSource}"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Margin="5"/>

                    <!-- EMPTY IMAGE PLACEHOLDER -->

                    <TextBlock Text="LIVE DETECTOR IMAGE"
                               Foreground="Gray"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding CapturedImageSource}"
                                                 Value="{x:Null}">

                                        <Setter Property="Visibility"
                                                Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                    <!-- ONLY RULER ON RT IMAGE -->

                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="15"
                            Padding="12,6"
                            Background="#252B33"
                            CornerRadius="5">

                        <StackPanel>

                            <TextBlock Text="PIPE POSITION"
                                       Foreground="#B0BEC5"
                                       FontSize="9"
                                       HorizontalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,2,0,0">

                                <TextBlock Text="{Binding CurrentShotStart, StringFormat={}{0:0} mm}"
                                           Foreground="White"
                                           FontSize="12"/>

                                <TextBlock Text="  ─────────────  "
                                           Foreground="#00E5FF"
                                           FontSize="12"/>

                                <TextBlock Text="{Binding CurrentShotEnd, StringFormat={}{0:0} mm}"
                                           Foreground="White"
                                           FontSize="12"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>

            <!-- RIGHT -->

            <Border Grid.Column="2"
                    Background="#252B33"
                    CornerRadius="8"
                    Margin="8,0,0,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="12">

                        <TextBlock Text="RT Shot Status"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                        <Border Background="#1F232A"
                                CornerRadius="6"
                                Margin="0,12,0,0"
                                Padding="10">

                            <StackPanel>

                                <TextBlock Text="Work Order"
                                           Foreground="#B0BEC5"
                                           FontSize="10"/>

                                <TextBlock Text="{Binding CurrentWorkOrder, Mode=OneWay}"
                                           Foreground="#00E5FF"
                                           FontSize="14"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Pipe ID"
                                           Foreground="#B0BEC5"
                                           FontSize="10"
                                           Margin="0,10,0,0"/>

                                <TextBlock Text="{Binding PipeId}"
                                           Foreground="#00E5FF"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Current Shot"
                                           Foreground="#B0BEC5"
                                           FontSize="10"
                                           Margin="0,10,0,0"/>

                                <TextBlock Text="{Binding CurrentShotNumber}"
                                           Foreground="#00E5FF"
                                           FontSize="30"
                                           FontWeight="Bold"/>

                                <TextBlock Text="{Binding TotalShots, StringFormat=of {0} total shots}"
                                           Foreground="#B0BEC5"
                                           FontSize="11"/>

                            </StackPanel>

                        </Border>

                        <Separator Margin="0,14"/>

                        <TextBlock Text="Position"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding CurrentShotStart, StringFormat=Start: {0:0} mm}"
                                   Foreground="#B0BEC5"
                                   FontSize="11"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="{Binding CurrentShotEnd, StringFormat=End: {0:0} mm}"
                                   Foreground="#B0BEC5"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>

                        <TextBlock Text="{Binding Overlap, StringFormat=Overlap: {0:0} mm}"
                                   Foreground="#B0BEC5"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>

                        <Separator Margin="0,14"/>

                        <TextBlock Text="Detector"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding ConnectionStatus}"
                                   Foreground="Lime"
                                   FontSize="13"
                                   Margin="0,10,0,0"/>

                        <Separator Margin="0,14"/>

                        <TextBlock Text="Frame"
                                   Foreground="#B0BEC5"
                                   FontSize="11"/>

                        <TextBlock Text="{Binding FrameNumber}"
                                   Foreground="#00E5FF"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,5"/>

                        <Separator Margin="0,12"/>

                        <TextBlock Text="Exposure"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding KV, StringFormat=KV: {0:F1}}"
                                   Foreground="#B0BEC5"
                                   FontSize="11"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="{Binding MA, StringFormat=mA: {0:F2}}"
                                   Foreground="#B0BEC5"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>

                        <TextBlock Text="{Binding ExposureTime, StringFormat=Time: {0:F2} s}"
                                   Foreground="#B0BEC5"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

        <!-- FOOTER -->

        <Border Grid.Row="2"
                Background="#252B33"
                CornerRadius="8">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Button Content="Connect"
                        Width="110"
                        Height="40"
                        Margin="4"
                        Command="{Binding ConnectCommand}"/>

                <Button Content="Capture"
                        Width="110"
                        Height="40"
                        Margin="4"
                        Command="{Binding CaptureCommand}"/>

                <Button Content="Save"
                        Width="110"
                        Height="40"
                        Margin="4"
                        Click="SaveButton_Click"/>

                <Button Content="Retake"
                        Width="110"
                        Height="40"
                        Margin="4"
                        Command="{Binding RetakeCommand}"/>

                <Button Content="Window / Level"
                        Width="135"
                        Height="40"
                        Margin="4"
                        Command="{Binding WindowLevelCommand}"/>

                <Button Content="Zoom"
                        Width="110"
                        Height="40"
                        Margin="4"
                        Command="{Binding ZoomCommand}"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>

