<UserControl x:Class="PS.SuperNDT.UI.Views.AcquisitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="8">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Acquisition"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding DetectorStatus}"
                               Foreground="Orange"
                               FontSize="18"
                               HorizontalAlignment="Right"/>

                    <TextBlock Text="{Binding AcquisitionStatus}"
                               Foreground="#B0BEC5"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               Margin="0,3,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- MAIN -->

        <Grid Grid.Row="1"
              Margin="0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT -->

            <Border Grid.Column="0"
                    Background="#252B33"
                    CornerRadius="8"
                    Margin="0,0,10,0">

                <StackPanel Margin="15">

                    <TextBlock Text="Job Information"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock Text="Current Job"
                               Foreground="White"
                               Margin="0,20,0,5"/>

                    <TextBox Height="35"
                             IsReadOnly="True"
                             Text="{Binding CurrentJob}"/>

                    <Separator Margin="0,20"/>

                    <TextBlock Text="Exposure"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock Text="kV"
                               Foreground="White"
                               Margin="0,15,0,5"/>

                    <TextBox Height="35"
                             Text="{Binding KV, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="mA"
                               Foreground="White"
                               Margin="0,15,0,5"/>

                    <TextBox Height="35"
                             Text="{Binding MA, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Exposure Time"
                               Foreground="White"
                               Margin="0,15,0,5"/>

                    <TextBox Height="35"
                             Text="{Binding ExposureTime, UpdateSourceTrigger=PropertyChanged}"/>

                </StackPanel>

            </Border>

            <!-- IMAGE AREA -->

            <Border Grid.Column="1"
                    Background="Black"
                    BorderBrush="#404040"
                    BorderThickness="1"
                    CornerRadius="8">

                <Grid>

                    <TextBlock Text="LIVE DETECTOR IMAGE"
                               Foreground="Gray"
                               FontSize="32"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="15"
                            Padding="10,5"
                            Background="#252B33"
                            CornerRadius="5">

                        <TextBlock Text="{Binding AcquisitionStatus}"
                                   Foreground="#00E5FF"
                                   FontSize="13"/>

                    </Border>

                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="15"
                            Padding="10,5"
                            Background="#252B33"
                            CornerRadius="5">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Frame: "
                                       Foreground="#B0BEC5"
                                       FontSize="14"/>

                            <TextBlock Text="{Binding FrameNumber}"
                                       Foreground="#00E5FF"
                                       FontSize="14"
                                       FontWeight="Bold"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>

            <!-- RIGHT -->

            <Border Grid.Column="2"
                    Background="#252B33"
                    CornerRadius="8"
                    Margin="10,0,0,0">

                <StackPanel Margin="15">

                    <TextBlock Text="Detector Status"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding ConnectionStatus}"
                               Foreground="Lime"
                               FontSize="16"
                               Margin="0,20,0,0"/>

                    <Separator Margin="0,20"/>

                    <TextBlock Text="Frame Number"
                               Foreground="White"/>

                    <TextBlock Text="{Binding FrameNumber}"
                               Foreground="#00E5FF"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,10"/>

                    <Separator Margin="0,15"/>

                    <TextBlock Text="Exposure Summary"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding KV, StringFormat=KV: {0:F1}}"
                               Foreground="#B0BEC5"
                               Margin="0,12,0,0"/>

                    <TextBlock Text="{Binding MA, StringFormat=mA: {0:F2}}"
                               Foreground="#B0BEC5"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="{Binding ExposureTime, StringFormat=Time: {0:F2} s}"
                               Foreground="#B0BEC5"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- FOOTER -->

        <Border Grid.Row="2"
                Background="#252B33"
                CornerRadius="8">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Button Content="Connect"
                        Width="120"
                        Height="45"
                        Margin="5"
                        Command="{Binding ConnectCommand}"/>

                <Button Content="Capture"
                        Width="120"
                        Height="45"
                        Margin="5"
                        Command="{Binding CaptureCommand}"/>

                <Button Content="Save"
                        Width="120"
                        Height="45"
                        Margin="5"
                        Command="{Binding SaveCommand}"/>

                <Button Content="Retake"
                        Width="120"
                        Height="45"
                        Margin="5"
                        Command="{Binding RetakeCommand}"/>

                <Button Content="Window / Level"
                        Width="150"
                        Height="45"
                        Margin="5"
                        Command="{Binding WindowLevelCommand}"/>

                <Button Content="Zoom"
                        Width="120"
                        Height="45"
                        Margin="5"
                        Command="{Binding ZoomCommand}"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>