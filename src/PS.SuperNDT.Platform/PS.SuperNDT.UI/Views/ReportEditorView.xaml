<UserControl x:Class="PS.SuperNDT.UI.Views.ReportEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Report Editor"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding Report.ReportNumber}"
                               Foreground="#9FA8B5"
                               FontSize="12"
                               Margin="0,4,0,0"/>

                </StackPanel>

                <Button Grid.Column="1"
                        Content="LOAD REVIEWED IMAGES"
                        Command="{Binding LoadReviewedImagesCommand}"
                        Height="36"
                        Padding="15,0"
                        Background="#3A424D"
                        Foreground="White"
                        BorderBrush="#5A6470"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>

            </Grid>

        </Border>


        <!-- MAIN -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.45*"/>
            </Grid.ColumnDefinitions>


            <!-- LEFT -->
            <Border Grid.Column="0"
                    Background="#252B33"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,5,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <!-- JOB DETAILS -->
                        <TextBlock Text="Job Details"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Customer"
                                   Foreground="#B8C0CC"
                                   Margin="0,15,0,5"/>

                        <TextBox Text="{Binding Report.Customer}"
                                 Height="32"
                                 Padding="8,4"/>

                        <TextBlock Text="Project"
                                   Foreground="#B8C0CC"
                                   Margin="0,10,0,5"/>

                        <TextBox Text="{Binding Report.Project}"
                                 Height="32"
                                 Padding="8,4"/>

                        <TextBlock Text="Component"
                                   Foreground="#B8C0CC"
                                   Margin="0,10,0,5"/>

                        <TextBox Text="{Binding Report.Component}"
                                 Height="32"
                                 Padding="8,4"/>

                        <TextBlock Text="Weld Number"
                                   Foreground="#B8C0CC"
                                   Margin="0,10,0,5"/>

                        <TextBox Text="{Binding Report.WeldNumber}"
                                 Height="32"
                                 Padding="8,4"/>

                        <TextBlock Text="Operator"
                                   Foreground="#B8C0CC"
                                   Margin="0,10,0,5"/>

                        <TextBox Text="{Binding Report.Operator}"
                                 Height="32"
                                 Padding="8,4"/>


                        <!-- REVIEWED IMAGES -->
                        <Border Background="#20252C"
                                CornerRadius="6"
                                Margin="0,18,0,0"
                                Padding="10">

                            <StackPanel>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Reviewed Inspection Images"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="Bold"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ReviewedImages.Count,
                                                      StringFormat={}{0} images}"
                                               Foreground="#9FA8B5"
                                               VerticalAlignment="Center"/>

                                </Grid>


                                <DataGrid ItemsSource="{Binding ReviewedImages}"
                                          SelectedItem="{Binding SelectedInspectionImage}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          Height="230"
                                          Margin="0,10,0,0"
                                          Background="#20252C"
                                          Foreground="White"
                                          BorderBrush="#404752"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Frame"
                                                            Binding="{Binding FrameNumber}"
                                                            Width="55"/>

                                        <DataGridTextColumn Header="Status"
                                                            Binding="{Binding ReviewStatus}"
                                                            Width="75"/>

                                        <DataGridTextColumn Header="Operator"
                                                            Binding="{Binding Operator}"
                                                            Width="95"/>

                                        <DataGridTextColumn Header="Detector"
                                                            Binding="{Binding DetectorName}"
                                                            Width="105"/>

                                        <DataGridTextColumn Header="Captured"
                                                            Binding="{Binding CapturedOn}"
                                                            Width="135"/>

                                    </DataGrid.Columns>

                                </DataGrid>


                                <Button Content="ADD SELECTED IMAGE TO REPORT"
                                        Command="{Binding AddSelectedImageCommand}"
                                        Height="36"
                                        Margin="0,10,0,0"
                                        Background="#315B3A"
                                        Foreground="White"
                                        BorderBrush="#4C8A59"
                                        FontWeight="Bold"
                                        Cursor="Hand"/>


                                <TextBlock Text="{Binding StatusMessage}"
                                           Foreground="#9FA8B5"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="2,8,2,0"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Border>


            <!-- RIGHT -->
            <Grid Grid.Column="1"
                  Margin="5,0,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="0.8*"/>
                </Grid.RowDefinitions>


                <!-- IMAGE PREVIEW -->
                <Border Grid.Row="0"
                        Background="#15191E"
                        BorderBrush="#404752"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,5">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- PREVIEW HEADER -->
                        <Grid Grid.Row="0"
                              Margin="5,2,5,8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Inspection Image Preview"
                                       Foreground="White"
                                       FontSize="17"
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedInspectionImage.ReviewStatus}"
                                       Foreground="#9FA8B5"
                                       FontWeight="Bold"/>

                        </Grid>


                        <!-- IMAGE -->
                        <Border Grid.Row="1"
                                Background="#080A0D"
                                CornerRadius="5">

                            <Grid>

                                <Image Source="{Binding SelectedInspectionImage.FilePath}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                                <TextBlock Text="No image selected"
                                           Foreground="#69727E"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding SelectedInspectionImage}"
                                                             Value="{x:Null}">

                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>

                        </Border>


                        <!-- IMAGE INFORMATION -->
                        <Grid Grid.Row="2"
                              Margin="5,8,5,2">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Frame"
                                           Foreground="#7F8995"
                                           FontSize="10"/>

                                <TextBlock Text="{Binding SelectedInspectionImage.FrameNumber}"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>

                            </StackPanel>


                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Detector"
                                           Foreground="#7F8995"
                                           FontSize="10"/>

                                <TextBlock Text="{Binding SelectedInspectionImage.DetectorName}"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>

                            </StackPanel>


                            <StackPanel Grid.Column="2">

                                <TextBlock Text="kV / mA"
                                           Foreground="#7F8995"
                                           FontSize="10"/>

                                <TextBlock Foreground="White"
                                           FontWeight="SemiBold">

                                    <Run Text="{Binding SelectedInspectionImage.KV}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding SelectedInspectionImage.MA}"/>

                                </TextBlock>

                            </StackPanel>


                            <StackPanel Grid.Column="3">

                                <TextBlock Text="Status"
                                           Foreground="#7F8995"
                                           FontSize="10"/>

                                <TextBlock Text="{Binding SelectedInspectionImage.ReviewStatus}"
                                           Foreground="White"
                                           FontWeight="Bold"/>

                            </StackPanel>

                        </Grid>

                    </Grid>

                </Border>


                <!-- REPORT IMAGES -->
                <Border Grid.Row="1"
                        Background="#252B33"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,5,0,0">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- HEADER -->
                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Images Included in Report"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Images.Count,
                                              StringFormat={}{0} images}"
                                       Foreground="#9FA8B5"/>

                        </Grid>


                        <!-- LIST -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Images}"
                                  SelectedItem="{Binding SelectedReportImage}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Margin="0,10,0,8"
                                  Background="#252B33"
                                  Foreground="White"
                                  BorderBrush="#404752"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="No."
                                                    Binding="{Binding SequenceNumber}"
                                                    Width="45"/>

                                <DataGridTextColumn Header="Image"
                                                    Binding="{Binding FileName}"
                                                    Width="170"/>

                                <DataGridTextColumn Header="Type"
                                                    Binding="{Binding ImageType}"
                                                    Width="90"/>

                                <DataGridTextColumn Header="Description"
                                                    Binding="{Binding Description}"
                                                    Width="160"/>

                                <DataGridTextColumn Header="Captured"
                                                    Binding="{Binding CapturedOn}"
                                                    Width="130"/>

                            </DataGrid.Columns>

                        </DataGrid>


                        <!-- REMOVE -->
                        <Button Grid.Row="2"
                                Content="REMOVE SELECTED IMAGE"
                                Command="{Binding RemoveSelectedImageCommand}"
                                Height="34"
                                HorizontalAlignment="Right"
                                Padding="15,0"
                                Background="#613535"
                                Foreground="White"
                                BorderBrush="#8B4A4A"
                                FontWeight="Bold"
                                Cursor="Hand"/>

                    </Grid>

                </Border>

            </Grid>

        </Grid>


        <!-- FOOTER -->
        <Border Grid.Row="2"
                Background="#252B33"
                CornerRadius="8"
                Padding="10"
                Margin="0,10,0,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#9FA8B5"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="GENERATE PREVIEW"
                        Command="{Binding GeneratePreviewCommand}"
                        Width="170"
                        Height="38"
                        Background="#315B3A"
                        Foreground="White"
                        BorderBrush="#4C8A59"
                        FontWeight="Bold"
                        Cursor="Hand"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>