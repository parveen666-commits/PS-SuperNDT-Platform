<UserControl x:Class="PS.SuperNDT.UI.Views.ReportEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#1F232A"
          Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <TextBlock Text="Report Editor"
                   Foreground="White"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="10"/>


        <Grid Grid.Row="1"
              Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>


            <!-- Job Details -->

            <Border Background="#252B33"
                    CornerRadius="8"
                    Padding="15"
                    Margin="5">

                <StackPanel>

                    <TextBlock Text="Job Details"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"/>


                    <TextBlock Text="Customer"
                               Foreground="White"
                               Margin="0,15,0,5"/>

                    <TextBox Text="{Binding Report.Customer}"
                             Height="30"/>


                    <TextBlock Text="Project"
                               Foreground="White"
                               Margin="0,10,0,5"/>

                    <TextBox Text="{Binding Report.Project}"
                             Height="30"/>


                    <TextBlock Text="Component"
                               Foreground="White"
                               Margin="0,10,0,5"/>

                    <TextBox Text="{Binding Report.Component}"
                             Height="30"/>


                    <TextBlock Text="Weld Number"
                               Foreground="White"
                               Margin="0,10,0,5"/>

                    <TextBox Text="{Binding Report.WeldNumber}"
                             Height="30"/>


                    <TextBlock Text="Operator"
                               Foreground="White"
                               Margin="0,10,0,5"/>

                    <TextBox Text="{Binding Report.Operator}"
                             Height="30"/>

                </StackPanel>

            </Border>



            <!-- Findings -->

            <Border Grid.Column="1"
                    Background="#252B33"
                    CornerRadius="8"
                    Padding="15"
                    Margin="5">


                <StackPanel>

                    <TextBlock Text="Inspection Findings"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"/>


                    <DataGrid ItemsSource="{Binding Findings}"
                              Margin="0,15,0,0"
                              Height="300"
                              AutoGenerateColumns="False">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="No."
                                                Binding="{Binding FindingNumber}"
                                                Width="50"/>

                            <DataGridTextColumn Header="Location"
                                                Binding="{Binding Location}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding Description}"
                                                Width="200"/>

                            <DataGridTextColumn Header="Evaluation"
                                                Binding="{Binding Evaluation}"
                                                Width="120"/>

                        </DataGrid.Columns>

                    </DataGrid>


                    <Button Content="Generate Preview"
                            Width="160"
                            Height="35"
                            Margin="0,20,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>