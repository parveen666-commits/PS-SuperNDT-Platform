<UserControl x:Class="PS.SuperNDT.UI.Views.ReportExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="15">

        <Border Background="#252B33"
                CornerRadius="8"
                Padding="20">

            <StackPanel>


                <TextBlock Text="Report Export"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,0,0,25"/>


                <TextBlock Text="Current Report"
                           Foreground="White"
                           FontSize="18"/>


                <TextBlock Text="{Binding CurrentReport.ReportNumber}"
                           Foreground="White"
                           Margin="0,10,0,0"/>


                <Button Content="Export PDF"
                        Width="140"
                        Height="35"
                        Margin="0,25,0,0"
                        HorizontalAlignment="Left"
                        Click="Export_Click"/>


                <TextBlock Text="{Binding ExportPath}"
                           Foreground="White"
                           Margin="0,20,0,0"
                           TextWrapping="Wrap"/>


            </StackPanel>

        </Border>


    </Grid>

</UserControl>