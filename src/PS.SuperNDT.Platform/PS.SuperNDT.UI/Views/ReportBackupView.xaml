<UserControl x:Class="PS.SuperNDT.UI.Views.ReportBackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="15">

        <Border Background="#252B33"
                CornerRadius="8"
                Padding="20">

            <StackPanel>

                <TextBlock Text="Report Backup"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Report File"
                           Foreground="White"/>

                <TextBox Text="{Binding SourceFile, UpdateSourceTrigger=PropertyChanged}"
                         Height="32"
                         Margin="0,5,0,0"/>

                <Button Content="Create Backup"
                        Width="150"
                        Height="35"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Left"
                        Click="CreateBackup_Click"/>

                <TextBlock Text="Backup File"
                           Foreground="White"
                           Margin="0,20,0,5"/>

                <TextBox Text="{Binding BackupFile}"
                         IsReadOnly="True"
                         Height="60"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#00C853"
                           Margin="0,15,0,0"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>