<UserControl x:Class="PS.SuperNDT.UI.Views.CalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="8">

            <TextBlock Text="NDT Exposure Calculator"
                       Margin="20,0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"/>

        </Border>

        <Grid Grid.Row="1"
              Margin="0,15,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Input -->

            <Border Grid.Column="0"
                    Background="#252B33"
                    CornerRadius="8"
                    Margin="0,0,10,0">

                <StackPanel Margin="20">

                    <TextBlock Text="Material"
                               Foreground="White"/>

                    <ComboBox Height="35"
                              Margin="0,5,0,15"
                              Text="{Binding Material, Mode=TwoWay}">
                        <ComboBoxItem Content="Carbon Steel"/>
                        <ComboBoxItem Content="Stainless Steel"/>
                        <ComboBoxItem Content="Aluminium"/>
                    </ComboBox>

                    <TextBlock Text="Thickness (mm)"
                               Foreground="White"/>

                    <TextBox Height="35"
                             Margin="0,5,0,15"
                             Text="{Binding Thickness,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Source"
                               Foreground="White"/>

                    <ComboBox Height="35"
                              Margin="0,5,0,15"
                              Text="{Binding Source, Mode=TwoWay}">
                        <ComboBoxItem Content="X-Ray"/>
                        <ComboBoxItem Content="Ir-192"/>
                        <ComboBoxItem Content="Co-60"/>
                        <ComboBoxItem Content="Se-75"/>
                    </ComboBox>

                    <TextBlock Text="Source Distance (mm)"
                               Foreground="White"/>

                    <TextBox Height="35"
                             Margin="0,5,0,15"
                             Text="{Binding SourceDistance,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Content="Calculate"
                            Height="45"
                            Margin="0,15,0,0"
                            Command="{Binding CalculateCommand}"/>

                </StackPanel>

            </Border>

            <!-- Result -->

            <Border Grid.Column="1"
                    Background="#252B33"
                    CornerRadius="8">

                <StackPanel Margin="20">

                    <TextBlock Text="Calculation Result"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"/>

                    <Border Margin="0,25,0,0"
                            Background="#2C313C"
                            CornerRadius="8"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="Recommended Exposure Time"
                                       Foreground="White"
                                       FontSize="18"/>

                            <TextBlock Text="{Binding ExposureTime}"
                                       FontSize="42"
                                       FontWeight="Bold"
                                       Foreground="#00E5FF"
                                       Margin="0,10,0,0"/>

                            <TextBlock Text="seconds"
                                       Foreground="White"
                                       FontSize="16"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>