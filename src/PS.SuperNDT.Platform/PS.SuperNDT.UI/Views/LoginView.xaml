<UserControl x:Class="PS.SuperNDT.UI.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid>

        <Border Width="420"
                Padding="25"
                Background="#252B33"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="PS SuperNDT Login"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Username"
                           Foreground="White"
                           Margin="0,0,0,5"/>

                <TextBox Height="35"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Password"
                           Foreground="White"
                           Margin="0,0,0,5"/>

                <PasswordBox Height="35"
                             Margin="0,0,0,20"/>

                <Button Content="Login"
                        Height="40"
                        FontWeight="SemiBold"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>