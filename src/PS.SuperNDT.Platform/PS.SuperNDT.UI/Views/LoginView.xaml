<UserControl x:Class="PS.SuperNDT.UI.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid>

        <Border Width="500"
                Padding="30"
                Background="#252B33"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="PS SuperNDT Platform"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="User Login"
                           Foreground="#C8C8C8"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,30"/>

                <TextBlock Text="Username"
                           Foreground="White"
                           FontSize="15"/>

                <TextBox Height="40"
                         Margin="0,5,0,15"
                         Text="{Binding Username,
                                        UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Password"
                           Foreground="White"
                           FontSize="15"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="40"
                             Margin="0,5,0,20"/>

                <Button Content="Login"
                        Height="45"
                        Command="{Binding LoginCommand}"/>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="Orange"
                           FontSize="14"
                           Margin="0,20,0,0"
                           TextWrapping="Wrap"/>

                <Separator Margin="0,20,0,15"/>

                <TextBlock Text="Default Login"
                           Foreground="White"
                           FontWeight="Bold"/>

                <TextBlock Text="Username : admin"
                           Foreground="#C8C8C8"/>

                <TextBlock Text="Password : admin"
                           Foreground="#C8C8C8"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>