<UserControl x:Class="PS.SuperNDT.UI.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PS.SuperNDT.UI.Views"
             Background="#1F232A">

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>


        <!-- LEFT IMAGE LIST -->

        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Border Grid.Row="0"
                    Background="#252B33"
                    CornerRadius="6">

                <TextBlock Text="Image Review"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="20,0"/>

            </Border>


            <Border Grid.Row="1"
                    Margin="0,10"
                    Background="#252B33"
                    CornerRadius="6">

                <Grid Margin="20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Current Job"
                               Foreground="White"
                               FontSize="18"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentJob}"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"/>

                </Grid>

            </Border>


            <Border Grid.Row="2"
                    Background="#252B33"
                    CornerRadius="6">

                <DataGrid Margin="10"
                          ItemsSource="{Binding Images}"
                          SelectedItem="{Binding SelectedImage}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Frame"
                                            Binding="{Binding FrameNumber}"
                                            Width="70"/>

                        <DataGridTextColumn Header="File"
                                            Binding="{Binding FileName}"
                                            Width="220"/>

                        <DataGridTextColumn Header="kV"
                                            Binding="{Binding KV}"
                                            Width="70"/>

                        <DataGridTextColumn Header="mA"
                                            Binding="{Binding MA}"
                                            Width="70"/>

                        <DataGridTextColumn Header="Time"
                                            Binding="{Binding CapturedOn}"
                                            Width="170"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>


        <!-- RIGHT VIEWER -->

        <Border Grid.Column="1"
                Margin="10,0,0,0"
                Background="#252B33"
                CornerRadius="6">

            <views:ImageViewerView/>

        </Border>


    </Grid>

</UserControl>