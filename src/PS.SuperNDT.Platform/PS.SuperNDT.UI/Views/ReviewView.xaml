<UserControl x:Class="PS.SuperNDT.UI.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <UserControl.Resources>

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#343B46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#566170"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

        </Style>


        <Style x:Key="InfoLabel"
               TargetType="TextBlock">

            <Setter Property="Foreground" Value="#8F9AAA"/>
            <Setter Property="FontSize" Value="10"/>

        </Style>


        <Style x:Key="InfoValue"
               TargetType="TextBlock">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

        </Style>


        <Style x:Key="ReviewDataGrid"
               TargetType="DataGrid">

            <Setter Property="Background" Value="#171B20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#46505C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#20252C"/>
            <Setter Property="AlternatingRowBackground" Value="#272D35"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3A424D"/>
            <Setter Property="VerticalGridLinesBrush" Value="#3A424D"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="FontSize" Value="12"/>

        </Style>


        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background" Value="#343B46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

        </Style>


        <Style TargetType="DataGridRow">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#20252C"/>

            <Style.Triggers>

                <Trigger Property="IsSelected" Value="True">

                    <Setter Property="Background" Value="#3D5872"/>
                    <Setter Property="Foreground" Value="White"/>

                </Trigger>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#344252"/>
                    <Setter Property="Foreground" Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <Style TargetType="DataGridCell">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

        </Style>


        <Style TargetType="ComboBoxItem">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#252B33"/>
            <Setter Property="Padding" Value="8,6"/>

        </Style>

    </UserControl.Resources>


    <Grid Margin="14">

        <Grid.RowDefinitions>

            <RowDefinition Height="64"/>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="8"
                Padding="18,0">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="PIPE IMAGE REVIEW"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding ReviewMessage}"
                               Foreground="#9AA5B3"
                               FontSize="11"
                               Margin="0,3,0,0"/>

                </StackPanel>


                <StackPanel Grid.Column="1"
                            Margin="20,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="TOTAL"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding TotalImages}"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>


                <StackPanel Grid.Column="2"
                            Margin="20,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="PENDING"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding PendingImages}"
                               Foreground="#FFD45A"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>


                <StackPanel Grid.Column="3"
                            Margin="20,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="ACCEPTED"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding AcceptedImages}"
                               Foreground="#55D66A"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>


                <StackPanel Grid.Column="4"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="REJECTED"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding RejectedImages}"
                               Foreground="#FF6B6B"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- FILTER -->

        <Border Grid.Row="1"
                Background="#252B33"
                CornerRadius="8"
                Margin="0,8,0,0"
                Padding="10">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <TextBox Grid.Column="0"
                         Height="36"
                         Margin="0,0,8,0"
                         Padding="10,5"
                         VerticalContentAlignment="Center"
                         Background="#171B20"
                         Foreground="White"
                         BorderBrush="#4A5563"
                         FontSize="13"
                         Text="{Binding SearchText,
                                        UpdateSourceTrigger=PropertyChanged}"/>


                <ComboBox Grid.Column="1"
                          Height="36"
                          Margin="0,0,8,0"
                          Padding="8,4"
                          Background="#171B20"
                          Foreground="White"
                          BorderBrush="#4A5563"
                          ItemsSource="{Binding StatusFilterItems}"
                          SelectedItem="{Binding ReviewStatusFilter}"/>


                <Button Grid.Column="2"
                        Content="REFRESH"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ActionButton}"/>


                <Button Grid.Column="3"
                        Content="CLEAR"
                        Command="{Binding ClearFilterCommand}"
                        Style="{StaticResource ActionButton}"/>


                <Button Grid.Column="4"
                        Content="OPEN"
                        Command="{Binding OpenImageCommand}"
                        Style="{StaticResource ActionButton}"/>


                <!-- ZOOM -->

                <StackPanel Grid.Column="5"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">

                    <Button Content="−"
                            Width="36"
                            Command="{Binding ZoomOutCommand}"
                            Style="{StaticResource ActionButton}"/>

                    <TextBlock Text="{Binding ZoomLevel,
                                              StringFormat={}{0:0.00}x}"
                               Foreground="White"
                               FontWeight="Bold"
                               Width="55"
                               TextAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Button Content="+"
                            Width="36"
                            Command="{Binding ZoomInCommand}"
                            Style="{StaticResource ActionButton}"/>

                    <Button Content="RESET"
                            Width="65"
                            Command="{Binding ResetZoomCommand}"
                            Style="{StaticResource ActionButton}"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- MAIN -->

        <Grid Grid.Row="2"
              Margin="0,10,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>

            </Grid.ColumnDefinitions>


            <!-- LEFT SHOT LIST -->

            <Border Grid.Column="0"
                    Background="#252B33"
                    CornerRadius="8"
                    Margin="0,0,10,0"
                    Padding="8">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="48"/>

                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <TextBlock Text="SHOT LIST"
                                   Foreground="#C5CDD8"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>


                        <TextBlock Grid.Column="1"
                                   Text="{Binding TotalImages,
                                                 StringFormat={}Shots: {0}}"
                                   Foreground="#7F8B99"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>

                    </Grid>


                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FilteredImages}"
                              SelectedItem="{Binding SelectedImage}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              AlternationCount="2"
                              Style="{StaticResource ReviewDataGrid}">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="#"
                                                Binding="{Binding ShotNumber}"
                                                Width="45"/>

                            <DataGridTextColumn Header="POSITION"
                                                Binding="{Binding ShotPosition}"
                                                Width="110"/>

                            <DataGridTextColumn Header="STATUS"
                                                Binding="{Binding ReviewStatus}"
                                                Width="90"/>

                        </DataGrid.Columns>

                    </DataGrid>


                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <Button Grid.Column="0"
                                Content="◀ PREVIOUS"
                                Command="{Binding PreviousImageCommand}"
                                IsEnabled="{Binding HasPreviousImage}"
                                Style="{StaticResource ActionButton}"/>


                        <Button Grid.Column="1"
                                Content="NEXT ▶"
                                Command="{Binding NextImageCommand}"
                                IsEnabled="{Binding HasNextImage}"
                                Style="{StaticResource ActionButton}"/>

                    </Grid>

                </Grid>

            </Border>


            <!-- PIPE IMAGE VIEWER -->

            <Border Grid.Column="1"
                    Background="#080A0D"
                    BorderBrush="#3F4854"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,10,0"
                    ClipToBounds="True">

                <Grid ClipToBounds="True">


                    <!-- IMAGE HEADER -->

                    <Border VerticalAlignment="Top"
                            Background="#252B33"
                            CornerRadius="8,8,0,0"
                            Padding="12,8"
                            Panel.ZIndex="10">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock Text="{Binding SelectedImage.FileName,
                                                          TargetNullValue=NO SHOT SELECTED}"
                                           Foreground="White"
                                           FontSize="13"
                                           FontWeight="Bold"/>

                                <TextBlock Text="{Binding SelectedImage.ShotPosition,
                                                          TargetNullValue=—}"
                                           Foreground="#8F9AAA"
                                           FontSize="11"/>

                            </StackPanel>


                            <Button Grid.Column="1"
                                    Content="◀"
                                    Width="38"
                                    Command="{Binding PreviousImageCommand}"
                                    IsEnabled="{Binding HasPreviousImage}"
                                    Style="{StaticResource ActionButton}"/>


                            <Button Grid.Column="2"
                                    Content="▶"
                                    Width="38"
                                    Command="{Binding NextImageCommand}"
                                    IsEnabled="{Binding HasNextImage}"
                                    Style="{StaticResource ActionButton}"/>

                        </Grid>

                    </Border>


                    <!-- IMAGE + RULER VIEWPORT -->

                    <Grid Margin="0,48,0,44"
                          Background="#080A0D"
                          ClipToBounds="True">

                        <Grid HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              ClipToBounds="True">

                            <!-- IMAGE -->

                            <Image Source="{Binding DisplayImage}"
                                   Stretch="None"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">

                                <Image.RenderTransform>

                                    <ScaleTransform ScaleX="{Binding ZoomLevel}"
                                                    ScaleY="{Binding ZoomLevel}"/>

                                </Image.RenderTransform>

                            </Image>


                            <!-- RULER OVERLAY -->

                            <Border VerticalAlignment="Bottom"
                                    Height="64"
                                    Background="#D90B0D10"
                                    BorderBrush="#65707D"
                                    BorderThickness="0,1,0,0"
                                    Padding="10,5"
                                    IsHitTestVisible="False">

                                <Grid>

                                    <Grid.RowDefinitions>

                                        <RowDefinition Height="22"/>
                                        <RowDefinition Height="25"/>

                                    </Grid.RowDefinitions>


                                    <!-- RULER LINE -->

                                    <Border Grid.Row="1"
                                            Height="2"
                                            Background="#D8DEE7"
                                            VerticalAlignment="Top"
                                            Margin="0,8,0,0"/>


                                    <!-- 10 MM TICKS -->

                                    <UniformGrid Grid.Row="1"
                                                 Rows="1"
                                                 Columns="31"
                                                 VerticalAlignment="Top"
                                                 Margin="0,0,0,0">

                                        <Rectangle Width="1"
                                                   Height="8"
                                                   Fill="#D8DEE7"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="11"
                                                   Fill="#FFFFFF"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="11"
                                                   Fill="#FFFFFF"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="11"
                                                   Fill="#FFFFFF"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="11"
                                                   Fill="#FFFFFF"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="11"
                                                   Fill="#FFFFFF"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="5"
                                                   Fill="#9CA7B5"
                                                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="1"
                                                   Height="11"
                                                   Fill="#FFFFFF"
                                                   HorizontalAlignment="Left"/>

                                    </UniformGrid>


                                    <!-- LABELS -->

                                    <Grid Grid.Row="0">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>


                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding SelectedImage.ShotStartPosition,
                                                                  StringFormat={}{0:0} mm}"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   FontWeight="Bold"/>


                                        <TextBlock Grid.Column="1"
                                                   Text="50"
                                                   Foreground="#D8DEE7"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"/>


                                        <TextBlock Grid.Column="2"
                                                   Text="100"
                                                   Foreground="#D8DEE7"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"/>


                                        <TextBlock Grid.Column="3"
                                                   Text="150"
                                                   Foreground="#D8DEE7"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"/>


                                        <TextBlock Grid.Column="4"
                                                   Text="200"
                                                   Foreground="#D8DEE7"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"/>


                                        <TextBlock Grid.Column="5"
                                                   Text="250"
                                                   Foreground="#D8DEE7"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"/>


                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding SelectedImage.ShotEndPosition,
                                                                  StringFormat={}{0:0} mm}"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"/>

                                    </Grid>

                                </Grid>

                            </Border>


                            <!-- NO IMAGE -->

                            <TextBlock Text="NO IMAGE SELECTED"
                                       Foreground="#65707D"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">

                                <TextBlock.Style>

                                    <Style TargetType="TextBlock">

                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding SelectedImage}"
                                                         Value="{x:Null}">

                                                <Setter Property="Visibility"
                                                        Value="Visible"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>

                        </Grid>

                    </Grid>


                    <!-- FOOTER -->

                    <Border VerticalAlignment="Bottom"
                            Background="#252B33"
                            CornerRadius="0,0,8,8"
                            Padding="12,7"
                            Panel.ZIndex="10">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock Text="{Binding ReviewMessage}"
                                       Foreground="#9AA5B3"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>


                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedImage.ShotNumber,
                                                     StringFormat={}SHOT {0}}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       Margin="10,0"
                                       VerticalAlignment="Center"/>


                            <TextBlock Grid.Column="2"
                                       Text="{Binding SelectedImage.TotalShots,
                                                     StringFormat={}/ {0}}"
                                       Foreground="#8F9AAA"
                                       VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                </Grid>

            </Border>


            <!-- RIGHT DETAILS -->

            <Border Grid.Column="2"
                    Background="#252B33"
                    CornerRadius="8"
                    Padding="12">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="SHOT DETAILS"
                                   Foreground="#C5CDD8"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Margin="2,0,0,10"/>


                        <Border Background="#20252C"
                                CornerRadius="6"
                                Padding="10">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <StackPanel>

                                    <TextBlock Text="SHOT"
                                               Style="{StaticResource InfoLabel}"/>

                                    <TextBlock Text="{Binding SelectedImage.ShotNumber,
                                                              TargetNullValue=—}"
                                               Style="{StaticResource InfoValue}"/>


                                    <TextBlock Text="TOTAL SHOTS"
                                               Style="{StaticResource InfoLabel}"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="{Binding SelectedImage.TotalShots,
                                                              TargetNullValue=—}"
                                               Style="{StaticResource InfoValue}"/>


                                    <TextBlock Text="START"
                                               Style="{StaticResource InfoLabel}"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="{Binding SelectedImage.ShotStartPosition,
                                                              StringFormat={}{0:0} mm,
                                                              TargetNullValue=—}"
                                               Style="{StaticResource InfoValue}"/>

                                </StackPanel>


                                <StackPanel Grid.Column="1">

                                    <TextBlock Text="END"
                                               Style="{StaticResource InfoLabel}"/>

                                    <TextBlock Text="{Binding SelectedImage.ShotEndPosition,
                                                              StringFormat={}{0:0} mm,
                                                              TargetNullValue=—}"
                                               Style="{StaticResource InfoValue}"/>


                                    <TextBlock Text="SHOT SIZE"
                                               Style="{StaticResource InfoLabel}"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="{Binding SelectedImage.ShotSize,
                                                              StringFormat={}{0:0} mm,
                                                              TargetNullValue=—}"
                                               Style="{StaticResource InfoValue}"/>


                                    <TextBlock Text="OVERLAP"
                                               Style="{StaticResource InfoLabel}"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="{Binding SelectedImage.Overlap,
                                                              StringFormat={}{0:0} mm,
                                                              TargetNullValue=—}"
                                               Style="{StaticResource InfoValue}"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <Border Background="#20252C"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,8,0,0">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <StackPanel>

                                    <TextBlock Text="kV"
                                               Style="{StaticResource InfoLabel}"/>

                                    <TextBlock Text="{Binding SelectedImage.KV,
                                                              TargetNullValue=—}"
                                               Style="{StaticResource InfoValue}"/>


                                    <TextBlock Text="mA"
                                               Style="{StaticResource InfoLabel}"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="{Binding SelectedImage.MA,
                                                              TargetNullValue=—}"
                                               Style="{StaticResource InfoValue}"/>

                                </StackPanel>


                                <StackPanel Grid.Column="1">

                                    <TextBlock Text="EXPOSURE"
                                               Style="{StaticResource InfoLabel}"/>

                                    <TextBlock Text="{Binding SelectedImage.ExposureTime,
                                                              StringFormat={}{0:0.##} s,
                                                              TargetNullValue=—}"
                                               Style="{StaticResource InfoValue}"/>


                                    <TextBlock Text="FRAME"
                                               Style="{StaticResource InfoLabel}"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="{Binding SelectedImage.FrameNumber,
                                                              TargetNullValue=—}"
                                               Style="{StaticResource InfoValue}"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <Border Background="#20252C"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,8,0,0">

                            <StackPanel>

                                <TextBlock Text="JOB"
                                           Style="{StaticResource InfoLabel}"/>

                                <TextBlock Text="{Binding SelectedImage.JobNumber,
                                                          TargetNullValue=—}"
                                           Style="{StaticResource InfoValue}"/>


                                <TextBlock Text="OPERATOR"
                                           Style="{StaticResource InfoLabel}"
                                           Margin="0,8,0,0"/>

                                <TextBlock Text="{Binding SelectedImage.Operator,
                                                          TargetNullValue=—}"
                                           Style="{StaticResource InfoValue}"/>


                                <TextBlock Text="DETECTOR"
                                           Style="{StaticResource InfoLabel}"
                                           Margin="0,8,0,0"/>

                                <TextBlock Text="{Binding SelectedImage.DetectorName,
                                                          TargetNullValue=—}"
                                           Style="{StaticResource InfoValue}"/>


                                <TextBlock Text="FILE"
                                           Style="{StaticResource InfoLabel}"
                                           Margin="0,8,0,0"/>

                                <TextBlock Text="{Binding SelectedImage.FileName,
                                                          TargetNullValue=—}"
                                           Style="{StaticResource InfoValue}"
                                           TextTrimming="CharacterEllipsis"/>

                            </StackPanel>

                        </Border>


                        <Border Background="#20252C"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,8,0,0">

                            <StackPanel>

                                <TextBlock Text="REVIEW STATUS"
                                           Style="{StaticResource InfoLabel}"/>

                                <TextBlock Text="{Binding SelectedImage.ReviewStatus,
                                                          TargetNullValue=PENDING}"
                                           Foreground="White"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,4,0,6"/>


                                <TextBlock Text="{Binding SelectedImage.ReviewedBy,
                                                          TargetNullValue=Not reviewed}"
                                           Foreground="#B8C0CC"
                                           FontSize="11"/>


                                <TextBlock Text="{Binding SelectedImage.ReviewedOn,
                                                          StringFormat={}{0:dd-MM-yyyy HH:mm},
                                                          TargetNullValue=—}"
                                           Foreground="#B8C0CC"
                                           FontSize="11"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                        </Border>


                        <TextBlock Text="REVIEW ACTION"
                                   Foreground="#C5CDD8"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="2,12,0,4"/>


                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Button Grid.Column="0"
                                    Content="✓ ACCEPT"
                                    Command="{Binding ApproveCommand}"
                                    Background="#315B3A"
                                    BorderBrush="#4E8A5A"
                                    Style="{StaticResource ActionButton}"/>


                            <Button Grid.Column="1"
                                    Content="✕ REJECT"
                                    Command="{Binding RejectCommand}"
                                    Background="#633737"
                                    BorderBrush="#995050"
                                    Style="{StaticResource ActionButton}"/>

                        </Grid>


                        <Button Content="↺ MARK PENDING"
                                Command="{Binding PendingCommand}"
                                Background="#5B4B2A"
                                BorderBrush="#8D7540"
                                Style="{StaticResource ActionButton}"
                                Margin="3,2,3,0"/>


                        <Button Content="OPEN FULL IMAGE"
                                Command="{Binding OpenImageCommand}"
                                Style="{StaticResource ActionButton}"
                                Margin="3,8,3,0"/>


                        <Border Background="#20252C"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,10,0,0">

                            <StackPanel>

                                <TextBlock Text="REMARKS"
                                           Style="{StaticResource InfoLabel}"/>

                                <TextBlock Text="{Binding SelectedImage.Remarks,
                                                          TargetNullValue=No remarks}"
                                           Foreground="#B8C0CC"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>