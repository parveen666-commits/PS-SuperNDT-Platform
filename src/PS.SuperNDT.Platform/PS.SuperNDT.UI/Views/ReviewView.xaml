<UserControl x:Class="PS.SuperNDT.UI.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <UserControl.Resources>

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Margin"
                    Value="3"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="Background"
                    Value="#343B46"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#566170"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>


        <Style x:Key="InfoLabel"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="#8F9AAA"/>

            <Setter Property="FontSize"
                    Value="9"/>

        </Style>


        <Style x:Key="InfoValue"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>


        <Style x:Key="ReviewDataGrid"
               TargetType="DataGrid">

            <Setter Property="Background"
                    Value="#171B20"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#46505C"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="RowBackground"
                    Value="#20252C"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#272D35"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#3A424D"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="#3A424D"/>

            <Setter Property="RowHeight"
                    Value="32"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

        </Style>


        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#343B46"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#4B5563"/>

            <Setter Property="BorderThickness"
                    Value="0,0,1,1"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="6,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <Style TargetType="DataGridRow">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#20252C"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#3D5872"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#344252"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <Style TargetType="DataGridCell">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="5,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <!-- DARK COMBOBOX ITEM -->

        <Style x:Key="StatusComboBoxItemStyle"
               TargetType="ComboBoxItem">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#252B33"/>

            <Setter Property="Padding"
                    Value="10,8"/>

            <Setter Property="Margin"
                    Value="1"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#3D5872"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#4A6A8A"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <Grid Margin="12">

        <Grid.RowDefinitions>

            <RowDefinition Height="60"/>

            <RowDefinition Height="54"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="8"
                Padding="16,0">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>

                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="PIPE IMAGE REVIEW"
                               Foreground="White"
                               FontSize="21"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding ReviewMessage}"
                               Foreground="#9AA5B3"
                               FontSize="10"
                               Margin="0,2,0,0"/>

                </StackPanel>


                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="TOTAL"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding TotalImages}"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>


                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center">

                    <TextBlock Text="PENDING"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding PendingImages}"
                               Foreground="#FFD45A"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>


                <StackPanel Grid.Column="3"
                            VerticalAlignment="Center">

                    <TextBlock Text="ACCEPTED"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding AcceptedImages}"
                               Foreground="#55D66A"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>


                <StackPanel Grid.Column="4"
                            VerticalAlignment="Center">

                    <TextBlock Text="REJECTED"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding RejectedImages}"
                               Foreground="#FF6B6B"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- FILTER / ACTION -->

        <Border Grid.Row="1"
                Background="#252B33"
                CornerRadius="8"
                Margin="0,7,0,0"
                Padding="8">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- SEARCH -->

                <TextBox Grid.Column="0"
                         Height="34"
                         Margin="0,0,6,0"
                         Padding="9,4"
                         VerticalContentAlignment="Center"
                         Background="#171B20"
                         Foreground="White"
                         BorderBrush="#4A5563"
                         FontSize="12"
                         Text="{Binding SearchText,
                                UpdateSourceTrigger=PropertyChanged}"/>


                <!-- STATUS FILTER -->

                <ComboBox Grid.Column="1"
                          Height="34"
                          Margin="0,0,6,0"
                          Padding="6,3"
                          Background="#171B20"
                          Foreground="White"
                          BorderBrush="#4A5563"
                          BorderThickness="1"
                          ItemsSource="{Binding StatusFilterItems}"
                          SelectedItem="{Binding ReviewStatusFilter,
                                               Mode=TwoWay}"
                          SelectionChanged="ComboBox_SelectionChanged">

                    <ComboBox.Resources>

                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"
                                         Color="#252B33"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                                         Color="#252B33"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"
                                         Color="White"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                         Color="#3D5872"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                         Color="White"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                         Color="#3D5872"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                 Color="White"/>


                        <Style TargetType="ComboBoxItem">

                            <Setter Property="Foreground"
                                    Value="White"/>

                            <Setter Property="Background"
                                    Value="#252B33"/>

                            <Setter Property="Padding"
                                    Value="10,8"/>

                            <Setter Property="Margin"
                                    Value="1"/>

                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>

                            <Setter Property="VerticalContentAlignment"
                                    Value="Center"/>

                            <Setter Property="FontSize"
                                    Value="11"/>

                            <Setter Property="FontWeight"
                                    Value="SemiBold"/>

                            <Style.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter Property="Background"
                                            Value="#3D5872"/>

                                    <Setter Property="Foreground"
                                            Value="White"/>

                                </Trigger>

                                <Trigger Property="IsSelected"
                                         Value="True">

                                    <Setter Property="Background"
                                            Value="#4A6A8A"/>

                                    <Setter Property="Foreground"
                                            Value="White"/>

                                </Trigger>

                            </Style.Triggers>

                        </Style>

                    </ComboBox.Resources>

                </ComboBox>


                <!-- REFRESH -->

                <Button Grid.Column="2"
                        Content="REFRESH"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ActionButton}"/>


                <!-- CLEAR -->

                <Button Grid.Column="3"
                        Content="CLEAR"
                        Command="{Binding ClearFilterCommand}"
                        Style="{StaticResource ActionButton}"/>


                <!-- OPEN -->

                <Button Grid.Column="4"
                        Content="OPEN"
                        Command="{Binding OpenImageCommand}"
                        Style="{StaticResource ActionButton}"/>


                <!-- ZOOM -->

                <StackPanel Grid.Column="5"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="6,0,0,0">

                    <Button Content="−"
                            Width="34"
                            Command="{Binding ZoomOutCommand}"
                            Style="{StaticResource ActionButton}"/>

                    <TextBlock Text="{Binding ZoomLevel,
                                      StringFormat={}{0:0.00}x}"
                               Foreground="White"
                               FontWeight="Bold"
                               Width="50"
                               TextAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Button Content="+"
                            Width="34"
                            Command="{Binding ZoomInCommand}"
                            Style="{StaticResource ActionButton}"/>

                    <Button Content="RESET"
                            Width="58"
                            Command="{Binding ResetZoomCommand}"
                            Style="{StaticResource ActionButton}"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- MAIN -->

        <Grid Grid.Row="2"
              Margin="0,8,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="290"/>

            </Grid.ColumnDefinitions>


            <!-- LEFT SHOT LIST -->

            <Border Grid.Column="0"
                    Background="#252B33"
                    CornerRadius="8"
                    Margin="0,0,8,0"
                    Padding="7">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="44"/>

                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <TextBlock Text="SHOT LIST"
                                   Foreground="#C5CDD8"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding TotalImages,
                                          StringFormat={}Shots: {0}}"
                                   Foreground="#7F8B99"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>

                    </Grid>


                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FilteredImages}"
                              SelectedItem="{Binding SelectedImage}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              AlternationCount="2"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              Style="{StaticResource ReviewDataGrid}">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="#"
                                                Binding="{Binding ShotNumber}"
                                                Width="42"/>

                            <DataGridTextColumn Header="POSITION"
                                                Binding="{Binding ShotPosition}"
                                                Width="*"/>

                            <DataGridTextColumn Header="STATUS"
                                                Binding="{Binding ReviewStatus}"
                                                Width="82"/>

                        </DataGrid.Columns>

                    </DataGrid>


                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <Button Grid.Column="0"
                                Content="◀ PREVIOUS"
                                Command="{Binding PreviousImageCommand}"
                                IsEnabled="{Binding HasPreviousImage}"
                                Style="{StaticResource ActionButton}"/>


                        <Button Grid.Column="1"
                                Content="NEXT ▶"
                                Command="{Binding NextImageCommand}"
                                IsEnabled="{Binding HasNextImage}"
                                Style="{StaticResource ActionButton}"/>

                    </Grid>

                </Grid>

            </Border>


            <!-- CENTER PIPE VIEWER -->

            <Border Grid.Column="1"
                    Background="#080A0D"
                    BorderBrush="#3F4854"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,8,0"
                    ClipToBounds="True">

                <Grid ClipToBounds="True">


                    <!-- TOP BAR -->

                    <Border VerticalAlignment="Top"
                            Background="#252B33"
                            CornerRadius="8,8,0,0"
                            Padding="10,6"
                            Height="46"
                            Panel.ZIndex="20">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock Text="{Binding SelectedImage.FileName,
                                    TargetNullValue=NO SHOT SELECTED}"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"/>

                                <TextBlock Text="{Binding SelectedImage.ShotPosition,
                                    TargetNullValue=—}"
                                           Foreground="#8F9AAA"
                                           FontSize="10"/>

                            </StackPanel>


                            <Button Grid.Column="1"
                                    Content="◀"
                                    Width="34"
                                    Command="{Binding PreviousImageCommand}"
                                    IsEnabled="{Binding HasPreviousImage}"
                                    Style="{StaticResource ActionButton}"/>


                            <Button Grid.Column="2"
                                    Content="▶"
                                    Width="34"
                                    Command="{Binding NextImageCommand}"
                                    IsEnabled="{Binding HasNextImage}"
                                    Style="{StaticResource ActionButton}"/>

                        </Grid>

                    </Border>


                    <!-- VIEWPORT -->

                    <Grid x:Name="ImageViewport"
                          Margin="0,46,0,62"
                          Background="#080A0D"
                          ClipToBounds="True">


                        <!-- PAN + ZOOM CONTAINER -->

                        <Grid x:Name="ImagePanCanvas"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Background="Transparent"
                              ClipToBounds="False"
                              RenderTransformOrigin="0.5,0.5">

                            <Grid.RenderTransform>

                                <TransformGroup>

                                    <ScaleTransform
                                        ScaleX="{Binding ZoomLevel}"
                                        ScaleY="{Binding ZoomLevel}"/>

                                    <TranslateTransform
                                        x:Name="PanTransform"/>

                                </TransformGroup>

                            </Grid.RenderTransform>


                            <!-- IMAGE -->

                            <Image Source="{Binding DisplayImage}"
                                   Stretch="None"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>


                            <!-- DEFECT MARKING OVERLAY -->

                            <Canvas x:Name="DefectOverlayCanvas"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    IsHitTestVisible="False"
                                    Panel.ZIndex="10">

                                <Rectangle x:Name="DefectRectangle"
                                           Visibility="Collapsed"
                                           Stroke="#FF4D4D"
                                           StrokeThickness="2"
                                           Fill="#33FF4D4D"
                                           RadiusX="1"
                                           RadiusY="1"/>

                            </Canvas>


                            <!-- RULER -->

                            <Border VerticalAlignment="Bottom"
                                    Height="58"
                                    MinWidth="300"
                                    Background="#E60B0D10"
                                    BorderBrush="#65707D"
                                    BorderThickness="0,1,0,0"
                                    Padding="8,4"
                                    IsHitTestVisible="False"
                                    Panel.ZIndex="5">

                                <Grid>

                                    <Grid.RowDefinitions>

                                        <RowDefinition Height="18"/>
                                        <RowDefinition Height="30"/>

                                    </Grid.RowDefinitions>


                                    <Grid Grid.Row="0">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>


                                        <TextBlock Text="{Binding SelectedImage.ShotStartPosition,
                                            StringFormat={}{0:0} mm}"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>


                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SelectedImage.ShotEndPosition,
                                                   StringFormat={}{0:0} mm}"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>

                                    </Grid>


                                    <ItemsControl Grid.Row="1"
                                                  ItemsSource="{Binding RulerTicks}"
                                                  HorizontalContentAlignment="Stretch">

                                        <ItemsControl.ItemsPanel>

                                            <ItemsPanelTemplate>

                                                <UniformGrid Rows="1"/>

                                            </ItemsPanelTemplate>

                                        </ItemsControl.ItemsPanel>


                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate>

                                                <Grid>

                                                    <Border Height="2"
                                                            Background="#D8DEE7"
                                                            VerticalAlignment="Top"
                                                            Margin="0,7,0,0"/>


                                                    <Rectangle Width="1"
                                                               Fill="#D8DEE7"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Top">

                                                        <Rectangle.Style>

                                                            <Style TargetType="Rectangle">

                                                                <Setter Property="Height"
                                                                        Value="8"/>

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding IsMajor}"
                                                                                 Value="True">

                                                                        <Setter Property="Height"
                                                                                Value="16"/>

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </Rectangle.Style>

                                                    </Rectangle>


                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="White"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Bottom"/>

                                                </Grid>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </Grid>

                            </Border>

                        </Grid>

                    </Grid>


                    <!-- BOTTOM STATUS -->

                    <Border VerticalAlignment="Bottom"
                            Height="32"
                            Background="#171B20"
                            BorderBrush="#343B46"
                            BorderThickness="0,1,0,0"
                            Padding="10,0">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock Text="RULER: 10 mm minor / 50 mm major"
                                       Foreground="#7F8B99"
                                       FontSize="9"
                                       VerticalAlignment="Center"/>


                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedImage.ShotSize,
                                       StringFormat={}SHOT {0:0} mm}"
                                       Foreground="#C5CDD8"
                                       FontSize="9"
                                       Margin="12,0"
                                       VerticalAlignment="Center"/>


                            <TextBlock Grid.Column="2"
                                       Text="{Binding SelectedImage.Overlap,
                                       StringFormat={}OVERLAP {0:0} mm}"
                                       Foreground="#C5CDD8"
                                       FontSize="9"
                                       Margin="12,0"
                                       VerticalAlignment="Center"/>


                            <TextBlock Grid.Column="3"
                                       Text="{Binding ZoomLevel,
                                       StringFormat={}ZOOM {0:0.00}x}"
                                       Foreground="#C5CDD8"
                                       FontSize="9"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                </Grid>

            </Border>


            <!-- RIGHT DETAILS -->

            <Border Grid.Column="2"
                    Background="#252B33"
                    CornerRadius="8"
                    Padding="10">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="44"/>

                    </Grid.RowDefinitions>


                    <TextBlock Grid.Row="0"
                               Text="SHOT DETAILS"
                               Foreground="#C5CDD8"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>


                    <Grid Grid.Row="1">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>

                        </Grid.RowDefinitions>


                        <TextBlock Grid.Row="0"
                                   Text="FILE"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock Grid.Row="0"
                                   HorizontalAlignment="Right"
                                   Text="{Binding SelectedImage.FileName,
                                          TargetNullValue=—}"
                                   Style="{StaticResource InfoValue}"
                                   FontSize="11"/>


                        <TextBlock Grid.Row="1"
                                   Text="SHOT"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock Grid.Row="1"
                                   HorizontalAlignment="Right"
                                   Text="{Binding SelectedImage.ShotNumber,
                                          TargetNullValue=—}"
                                   Style="{StaticResource InfoValue}"/>


                        <TextBlock Grid.Row="2"
                                   Text="TOTAL SHOTS"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock Grid.Row="2"
                                   HorizontalAlignment="Right"
                                   Text="{Binding SelectedImage.TotalShots,
                                          TargetNullValue=—}"
                                   Style="{StaticResource InfoValue}"/>


                        <TextBlock Grid.Row="3"
                                   Text="POSITION"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock Grid.Row="3"
                                   HorizontalAlignment="Right"
                                   Text="{Binding SelectedImage.ShotPosition,
                                          TargetNullValue=—}"
                                   Style="{StaticResource InfoValue}"
                                   FontSize="11"/>


                        <TextBlock Grid.Row="4"
                                   Text="START"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock Grid.Row="4"
                                   HorizontalAlignment="Right"
                                   Text="{Binding SelectedImage.ShotStartPosition,
                                          StringFormat={}{0:0} mm}"
                                   Style="{StaticResource InfoValue}"/>


                        <TextBlock Grid.Row="5"
                                   Text="END"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock Grid.Row="5"
                                   HorizontalAlignment="Right"
                                   Text="{Binding SelectedImage.ShotEndPosition,
                                          StringFormat={}{0:0} mm}"
                                   Style="{StaticResource InfoValue}"/>


                        <TextBlock Grid.Row="6"
                                   Text="SHOT SIZE"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock Grid.Row="6"
                                   HorizontalAlignment="Right"
                                   Text="{Binding SelectedImage.ShotSize,
                                          StringFormat={}{0:0} mm}"
                                   Style="{StaticResource InfoValue}"/>


                        <TextBlock Grid.Row="7"
                                   Text="OVERLAP"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock Grid.Row="7"
                                   HorizontalAlignment="Right"
                                   Text="{Binding SelectedImage.Overlap,
                                          StringFormat={}{0:0} mm}"
                                   Style="{StaticResource InfoValue}"/>


                        <TextBlock Grid.Row="8"
                                   Text="KV"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock Grid.Row="8"
                                   HorizontalAlignment="Right"
                                   Text="{Binding SelectedImage.KV,
                                          StringFormat={}{0:0.0}}"
                                   Style="{StaticResource InfoValue}"/>


                        <TextBlock Grid.Row="9"
                                   Text="MA"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock Grid.Row="9"
                                   HorizontalAlignment="Right"
                                   Text="{Binding SelectedImage.MA,
                                          StringFormat={}{0:0.0}}"
                                   Style="{StaticResource InfoValue}"/>


                        <TextBlock Grid.Row="10"
                                   Text="EXPOSURE"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock Grid.Row="10"
                                   HorizontalAlignment="Right"
                                   Text="{Binding SelectedImage.ExposureTime,
                                          StringFormat={}{0:0.00} s}"
                                   Style="{StaticResource InfoValue}"/>


                        <TextBlock Grid.Row="11"
                                   Text="FRAME"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock Grid.Row="11"
                                   HorizontalAlignment="Right"
                                   Text="{Binding SelectedImage.FrameNumber,
                                          TargetNullValue=—}"
                                   Style="{StaticResource InfoValue}"/>


                        <TextBlock Grid.Row="12"
                                   Text="JOB"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock Grid.Row="12"
                                   HorizontalAlignment="Right"
                                   Text="{Binding SelectedImage.JobNumber,
                                          TargetNullValue=—}"
                                   Style="{StaticResource InfoValue}"
                                   FontSize="11"/>


                        <TextBlock Grid.Row="13"
                                   Text="OPERATOR"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock Grid.Row="13"
                                   HorizontalAlignment="Right"
                                   Text="{Binding SelectedImage.Operator,
                                          TargetNullValue=—}"
                                   Style="{StaticResource InfoValue}"
                                   FontSize="11"/>


                        <TextBlock Grid.Row="14"
                                   Text="DETECTOR"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock Grid.Row="14"
                                   HorizontalAlignment="Right"
                                   Text="{Binding SelectedImage.DetectorName,
                                          TargetNullValue=—}"
                                   Style="{StaticResource InfoValue}"
                                   FontSize="11"/>


                        <TextBlock Grid.Row="15"
                                   Text="STATUS"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock Grid.Row="15"
                                   HorizontalAlignment="Right"
                                   Text="{Binding SelectedImage.ReviewStatus,
                                          TargetNullValue=—}"
                                   Style="{StaticResource InfoValue}"/>


                        <TextBlock Grid.Row="16"
                                   Text="REVIEWED BY"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock Grid.Row="16"
                                   HorizontalAlignment="Right"
                                   Text="{Binding SelectedImage.ReviewedBy,
                                          TargetNullValue=—}"
                                   Style="{StaticResource InfoValue}"
                                   FontSize="10"/>

                    </Grid>


                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <Button Grid.Column="0"
                                Content="PENDING"
                                Command="{Binding PendingCommand}"
                                Style="{StaticResource ActionButton}"/>


                        <Button Grid.Column="1"
                                Content="ACCEPT"
                                Command="{Binding ApproveCommand}"
                                Style="{StaticResource ActionButton}"/>


                        <Button Grid.Column="2"
                                Content="REJECT"
                                Command="{Binding RejectCommand}"
                                Style="{StaticResource ActionButton}"/>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>