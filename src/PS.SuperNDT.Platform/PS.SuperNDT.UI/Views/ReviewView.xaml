<UserControl x:Class="PS.SuperNDT.UI.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="8">

            <TextBlock Text="Review"
                       Margin="20,0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"/>

        </Border>

        <!-- Content -->

        <Grid Grid.Row="1"
              Margin="0,15,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Preview Panel -->

            <Border Grid.Column="0"
                    Background="#252B33"
                    CornerRadius="8"
                    Margin="0,0,10,0">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="140"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="Black"
                            BorderBrush="#404040"
                            BorderThickness="1">

                        <TextBlock Text="IMAGE PREVIEW"
                                   Foreground="Gray"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Grid.Row="1"
                                Margin="0,10,0,0">

                        <TextBlock Text="{Binding SelectedImage.JobNumber,
                                                  TargetNullValue=No Image Selected}"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding SelectedImage.Operator}"
                                   Foreground="White"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="{Binding SelectedImage.DetectorName}"
                                   Foreground="White"
                                   Margin="0,4,0,0"/>

                        <TextBlock Text="{Binding SelectedImage.CapturedOn}"
                                   Foreground="White"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- Records Grid -->

            <Border Grid.Column="1"
                    Background="#252B33"
                    CornerRadius="8">

                <DataGrid ItemsSource="{Binding Images}"
                          SelectedItem="{Binding SelectedImage}"
                          Margin="10"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Frame"
                                            Binding="{Binding FrameNumber}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Job Number"
                                            Binding="{Binding JobNumber}"
                                            Width="160"/>

                        <DataGridTextColumn Header="Operator"
                                            Binding="{Binding Operator}"
                                            Width="140"/>

                        <DataGridTextColumn Header="kV"
                                            Binding="{Binding KV}"
                                            Width="80"/>

                        <DataGridTextColumn Header="mA"
                                            Binding="{Binding MA}"
                                            Width="80"/>

                        <DataGridTextColumn Header="Exposure"
                                            Binding="{Binding ExposureTime}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Detector"
                                            Binding="{Binding DetectorName}"
                                            Width="140"/>

                        <DataGridTextColumn Header="Captured On"
                                            Binding="{Binding CapturedOn}"
                                            Width="180"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

    </Grid>

</UserControl>