<UserControl x:Class="PS.SuperNDT.UI.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <UserControl.Resources>

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Margin"
                    Value="4"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="Background"
                    Value="#343B46"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#515B68"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

        <Style x:Key="InfoLabel"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="#8F9AAA"/>

            <Setter Property="FontSize"
                    Value="11"/>

        </Style>

        <Style x:Key="InfoValue"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>

    </UserControl.Resources>

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="8"
                Padding="18,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="IMAGE REVIEW"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding ReviewMessage}"
                               Foreground="#8F9AAA"
                               FontSize="11"
                               Margin="0,3,0,0"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="15,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="TOTAL"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding TotalImages}"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="15,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="PENDING"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding PendingImages}"
                               Foreground="#FFD45A"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>

                <StackPanel Grid.Column="3"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="ACCEPTED"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding AcceptedImages}"
                               Foreground="#55D66A"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- FILTER -->

        <Border Grid.Row="1"
                Background="#252B33"
                CornerRadius="8"
                Margin="0,10,0,0"
                Padding="12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchText,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Height="36"
                         Padding="10,6"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         Background="#1F232A"
                         Foreground="White"
                         BorderBrush="#4A5360"
                         FontSize="13">

                    <TextBox.ToolTip>
                        Search Job / File / Operator / Detector / Shot No.
                    </TextBox.ToolTip>

                </TextBox>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding
                              RelativeSource={RelativeSource AncestorType=UserControl},
                              Path=DataContext.StatusFilterItems}"
                          SelectedItem="{Binding ReviewStatusFilter,
                                                 UpdateSourceTrigger=PropertyChanged}"
                          Height="36"
                          Margin="0,0,10,0"
                          Background="#1F232A"
                          Foreground="White"
                          BorderBrush="#4A5360"
                          Padding="8,4"/>

                <Button Grid.Column="2"
                        Content="REFRESH"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ActionButton}"/>

                <Button Grid.Column="3"
                        Content="CLEAR"
                        Command="{Binding ClearFilterCommand}"
                        Style="{StaticResource ActionButton}"/>

                <Button Grid.Column="4"
                        Content="OPEN"
                        Command="{Binding OpenImageCommand}"
                        Style="{StaticResource ActionButton}"/>

            </Grid>

        </Border>

        <!-- MAIN -->

        <Grid Grid.Row="2"
              Margin="0,10,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <!-- IMAGE LIST -->

            <Border Grid.Column="0"
                    Background="#252B33"
                    CornerRadius="8"
                    Margin="0,0,10,0">

                <DataGrid ItemsSource="{Binding FilteredImages}"
                          SelectedItem="{Binding SelectedImage}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Margin="10"
                          Background="#252B33"
                          Foreground="White"
                          BorderBrush="#404752"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="SHOT"
                                            Binding="{Binding ShotNumber}"
                                            Width="60"/>

                        <DataGridTextColumn Header="TOTAL"
                                            Binding="{Binding TotalShots}"
                                            Width="55"/>

                        <DataGridTextColumn Header="POSITION"
                                            Binding="{Binding ShotPosition}"
                                            Width="125"/>

                        <DataGridTextColumn Header="FRAME"
                                            Binding="{Binding FrameNumber}"
                                            Width="65"/>

                        <DataGridTextColumn Header="JOB"
                                            Binding="{Binding JobNumber}"
                                            Width="130"/>

                        <DataGridTextColumn Header="OPERATOR"
                                            Binding="{Binding Operator}"
                                            Width="110"/>

                        <DataGridTextColumn Header="DETECTOR"
                                            Binding="{Binding DetectorName}"
                                            Width="120"/>

                        <DataGridTextColumn Header="kV"
                                            Binding="{Binding KV}"
                                            Width="55"/>

                        <DataGridTextColumn Header="mA"
                                            Binding="{Binding MA}"
                                            Width="55"/>

                        <DataGridTextColumn Header="STATUS"
                                            Binding="{Binding ReviewStatus}"
                                            Width="90"/>

                        <DataGridTextColumn Header="CAPTURED"
                                            Binding="{Binding CapturedOn,
                                                              StringFormat={}{0:dd-MM-yyyy HH:mm}}"
                                            Width="135"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

            <!-- DETAILS -->

            <Border Grid.Column="1"
                    Background="#252B33"
                    CornerRadius="8"
                    Padding="14">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="260"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TITLE -->

                    <TextBlock Grid.Row="0"
                               Text="SELECTED SHOT"
                               Foreground="#B8C0CC"
                               FontSize="12"
                               FontWeight="Bold"
                               Margin="2,0,0,8"/>

                    <!-- IMAGE -->

                    <Border Grid.Row="1"
                            Background="Black"
                            BorderBrush="#404752"
                            BorderThickness="1">

                        <Grid>

                            <Image Source="{Binding SelectedImage.FilePath}"
                                   Stretch="Uniform"
                                   Margin="5"/>

                            <TextBlock Text="NO IMAGE SELECTED"
                                       Foreground="#707783"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">

                                <TextBlock.Style>

                                    <Style TargetType="TextBlock">

                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding SelectedImage}"
                                                         Value="{x:Null}">

                                                <Setter Property="Visibility"
                                                        Value="Visible"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>

                        </Grid>

                    </Border>

                    <!-- SHOT INFO -->

                    <Border Grid.Row="2"
                            Background="#20252C"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,10,0,0">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="SHOT"
                                           Style="{StaticResource InfoLabel}"/>

                                <TextBlock Text="{Binding SelectedImage.ShotNumber,
                                                          TargetNullValue=—}"
                                           Style="{StaticResource InfoValue}"/>

                                <TextBlock Text="POSITION"
                                           Style="{StaticResource InfoLabel}"
                                           Margin="0,8,0,0"/>

                                <TextBlock Text="{Binding SelectedImage.ShotPosition,
                                                          TargetNullValue=—}"
                                           Style="{StaticResource InfoValue}"/>

                                <TextBlock Text="PIPE LENGTH"
                                           Style="{StaticResource InfoLabel}"
                                           Margin="0,8,0,0"/>

                                <TextBlock Text="{Binding SelectedImage.PipeLength,
                                                          StringFormat={}{0:0} mm,
                                                          TargetNullValue=—}"
                                           Style="{StaticResource InfoValue}"/>

                            </StackPanel>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="SHOT SIZE"
                                           Style="{StaticResource InfoLabel}"/>

                                <TextBlock Text="{Binding SelectedImage.ShotSize,
                                                          StringFormat={}{0:0} mm,
                                                          TargetNullValue=—}"
                                           Style="{StaticResource InfoValue}"/>

                                <TextBlock Text="OVERLAP"
                                           Style="{StaticResource InfoLabel}"
                                           Margin="0,8,0,0"/>

                                <TextBlock Text="{Binding SelectedImage.Overlap,
                                                          StringFormat={}{0:0} mm,
                                                          TargetNullValue=—}"
                                           Style="{StaticResource InfoValue}"/>

                                <TextBlock Text="FILE"
                                           Style="{StaticResource InfoLabel}"
                                           Margin="0,8,0,0"/>

                                <TextBlock Text="{Binding SelectedImage.FileName,
                                                          TargetNullValue=—}"
                                           Style="{StaticResource InfoValue}"
                                           TextTrimming="CharacterEllipsis"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <!-- EXPOSURE -->

                    <Border Grid.Row="3"
                            Background="#20252C"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,8,0,0">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="kV"
                                           Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding SelectedImage.KV,
                                                          TargetNullValue=—}"
                                           Style="{StaticResource InfoValue}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="mA"
                                           Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding SelectedImage.MA,
                                                          TargetNullValue=—}"
                                           Style="{StaticResource InfoValue}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="EXPOSURE"
                                           Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding SelectedImage.ExposureTime,
                                                          StringFormat={}{0:0.##} s,
                                                          TargetNullValue=—}"
                                           Style="{StaticResource InfoValue}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="FRAME"
                                           Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding SelectedImage.FrameNumber,
                                                          TargetNullValue=—}"
                                           Style="{StaticResource InfoValue}"/>
                            </StackPanel>

                        </Grid>

                    </Border>

                    <!-- REVIEW -->

                    <Border Grid.Row="4"
                            Background="#20252C"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,8,0,0">

                        <StackPanel>

                            <TextBlock Text="REVIEW STATUS"
                                       Style="{StaticResource InfoLabel}"/>

                            <TextBlock Text="{Binding SelectedImage.ReviewStatus,
                                                      TargetNullValue=PENDING}"
                                       Foreground="White"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,4,0,10"/>

                            <TextBlock Text="{Binding SelectedImage.ReviewedBy,
                                                      TargetNullValue=Not reviewed}"
                                       Foreground="#B8C0CC"
                                       FontSize="12"/>

                            <TextBlock Text="{Binding SelectedImage.ReviewedOn,
                                                      StringFormat={}{0:dd-MM-yyyy HH:mm},
                                                      TargetNullValue=—}"
                                       Foreground="#B8C0CC"
                                       FontSize="12"
                                       Margin="0,3,0,0"/>

                            <TextBlock Text="{Binding SelectedImage.Remarks,
                                                      TargetNullValue=No remarks}"
                                       Foreground="#8F9AAA"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>

                        </StackPanel>

                    </Border>

                    <!-- ACTIONS -->

                    <Grid Grid.Row="5"
                          Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="OPEN"
                                Command="{Binding OpenImageCommand}"
                                Style="{StaticResource ActionButton}"/>

                        <Button Grid.Column="1"
                                Content="ACCEPT"
                                Command="{Binding ApproveCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="#315B3A"
                                BorderBrush="#4C8A59"/>

                        <Button Grid.Column="2"
                                Content="PENDING"
                                Command="{Binding PendingCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="#66552B"
                                BorderBrush="#9B803D"/>

                        <Button Grid.Column="3"
                                Content="REJECT"
                                Command="{Binding RejectCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="#633535"
                                BorderBrush="#A65353"/>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>