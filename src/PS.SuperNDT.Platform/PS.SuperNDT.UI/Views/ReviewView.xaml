<UserControl x:Class="PS.SuperNDT.UI.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="8">

            <TextBlock Text="Review"
                       Margin="20,0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"/>

        </Border>

        <!-- Filter Panel -->
        <Border Grid.Row="1"
                Background="#252B33"
                CornerRadius="8"
                Margin="0,12,0,0"
                Padding="12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <!-- Job Number -->
                <StackPanel Grid.Column="0"
                            Margin="0,0,10,0">

                    <TextBlock Text="Job Number"
                               Foreground="#B8C0CC"
                               FontSize="12"
                               Margin="2,0,0,5"/>

                    <TextBox Text="{Binding JobNumberFilter,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="34"
                             Padding="8,4"
                             Foreground="White"
                             Background="#1F232A"
                             BorderBrush="#4A5360"
                             BorderThickness="1"/>

                </StackPanel>

                <!-- Operator -->
                <StackPanel Grid.Column="1"
                            Margin="0,0,10,0">

                    <TextBlock Text="Operator"
                               Foreground="#B8C0CC"
                               FontSize="12"
                               Margin="2,0,0,5"/>

                    <TextBox Text="{Binding OperatorFilter,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="34"
                             Padding="8,4"
                             Foreground="White"
                             Background="#1F232A"
                             BorderBrush="#4A5360"
                             BorderThickness="1"/>

                </StackPanel>

                <!-- Detector -->
                <StackPanel Grid.Column="2"
                            Margin="0,0,10,0">

                    <TextBlock Text="Detector"
                               Foreground="#B8C0CC"
                               FontSize="12"
                               Margin="2,0,0,5"/>

                    <TextBox Text="{Binding DetectorFilter,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="34"
                             Padding="8,4"
                             Foreground="White"
                             Background="#1F232A"
                             BorderBrush="#4A5360"
                             BorderThickness="1"/>

                </StackPanel>

                <!-- Frame -->
                <StackPanel Grid.Column="3"
                            Margin="0,0,10,0">

                    <TextBlock Text="Frame"
                               Foreground="#B8C0CC"
                               FontSize="12"
                               Margin="2,0,0,5"/>

                    <TextBox Text="{Binding FrameFilter,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="34"
                             Padding="8,4"
                             Foreground="White"
                             Background="#1F232A"
                             BorderBrush="#4A5360"
                             BorderThickness="1"/>

                </StackPanel>

                <!-- Clear -->
                <Button Grid.Column="4"
                        Content="CLEAR FILTERS"
                        Command="{Binding ClearFilterCommand}"
                        Height="34"
                        Margin="5,20,0,0"
                        Background="#3A424D"
                        Foreground="White"
                        BorderBrush="#5A6470"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>

            </Grid>

        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2"
              Margin="0,12,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Preview Panel -->
            <Border Grid.Column="0"
                    Background="#252B33"
                    CornerRadius="8"
                    Margin="0,0,10,0">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="140"/>
                    </Grid.RowDefinitions>

                    <!-- Actual Image Preview -->
                    <Border Grid.Row="0"
                            Background="Black"
                            BorderBrush="#404040"
                            BorderThickness="1">

                        <Grid>

                            <!-- Selected Image -->
                            <Image Source="{Binding SelectedImage.FilePath}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                            <!-- No Image Message -->
                            <TextBlock Text="NO IMAGE SELECTED"
                                       Foreground="Gray"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">

                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">

                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding SelectedImage}"
                                                         Value="{x:Null}">

                                                <Setter Property="Visibility"
                                                        Value="Visible"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>
                                </TextBlock.Style>

                            </TextBlock>

                        </Grid>

                    </Border>

                    <!-- Image Information -->
                    <StackPanel Grid.Row="1"
                                Margin="0,10,0,0">

                        <TextBlock Text="{Binding SelectedImage.JobNumber,
                                                  TargetNullValue=No Image Selected}"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding SelectedImage.Operator}"
                                   Foreground="White"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="{Binding SelectedImage.DetectorName}"
                                   Foreground="White"
                                   Margin="0,4,0,0"/>

                        <TextBlock Text="{Binding SelectedImage.CapturedOn}"
                                   Foreground="White"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- Records Grid -->
            <Border Grid.Column="1"
                    Background="#252B33"
                    CornerRadius="8">

                <DataGrid ItemsSource="{Binding FilteredImages}"
                          SelectedItem="{Binding SelectedImage}"
                          Margin="10"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Background="#252B33"
                          Foreground="White"
                          BorderBrush="#404752"
                          BorderThickness="1"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Frame"
                                            Binding="{Binding FrameNumber}"
                                            Width="80"/>

                        <DataGridTextColumn Header="Job Number"
                                            Binding="{Binding JobNumber}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Operator"
                                            Binding="{Binding Operator}"
                                            Width="130"/>

                        <DataGridTextColumn Header="kV"
                                            Binding="{Binding KV}"
                                            Width="70"/>

                        <DataGridTextColumn Header="mA"
                                            Binding="{Binding MA}"
                                            Width="70"/>

                        <DataGridTextColumn Header="Exposure"
                                            Binding="{Binding ExposureTime}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Detector"
                                            Binding="{Binding DetectorName}"
                                            Width="140"/>

                        <DataGridTextColumn Header="Captured On"
                                            Binding="{Binding CapturedOn}"
                                            Width="180"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

    </Grid>

</UserControl>