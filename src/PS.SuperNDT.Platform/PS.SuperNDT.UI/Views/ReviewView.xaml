<UserControl x:Class="PS.SuperNDT.UI.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <UserControl.Resources>

        <!-- Status colors -->
        <Style x:Key="ReviewStatusCellStyle"
               TargetType="TextBlock">

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding ReviewStatus}"
                             Value="ACCEPT">

                    <Setter Property="Foreground"
                            Value="#55D66A"/>

                </DataTrigger>

                <DataTrigger Binding="{Binding ReviewStatus}"
                             Value="REJECT">

                    <Setter Property="Foreground"
                            Value="#FF6666"/>

                </DataTrigger>

                <DataTrigger Binding="{Binding ReviewStatus}"
                             Value="HOLD">

                    <Setter Property="Foreground"
                            Value="#FFD45A"/>

                </DataTrigger>

                <DataTrigger Binding="{Binding ReviewStatus}"
                             Value="PENDING">

                    <Setter Property="Foreground"
                            Value="#B8C0CC"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="8">

            <TextBlock Text="Review"
                       Margin="20,0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"/>

        </Border>

        <!-- Filter Panel -->
        <Border Grid.Row="1"
                Background="#252B33"
                CornerRadius="8"
                Margin="0,12,0,0"
                Padding="12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <!-- Job Number -->
                <StackPanel Grid.Column="0"
                            Margin="0,0,10,0">

                    <TextBlock Text="Job Number"
                               Foreground="#B8C0CC"
                               FontSize="12"
                               Margin="2,0,0,5"/>

                    <TextBox Text="{Binding JobNumberFilter,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="34"
                             Padding="8,4"
                             Foreground="White"
                             Background="#1F232A"
                             BorderBrush="#4A5360"/>

                </StackPanel>

                <!-- Operator -->
                <StackPanel Grid.Column="1"
                            Margin="0,0,10,0">

                    <TextBlock Text="Operator"
                               Foreground="#B8C0CC"
                               FontSize="12"
                               Margin="2,0,0,5"/>

                    <TextBox Text="{Binding OperatorFilter,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="34"
                             Padding="8,4"
                             Foreground="White"
                             Background="#1F232A"
                             BorderBrush="#4A5360"/>

                </StackPanel>

                <!-- Detector -->
                <StackPanel Grid.Column="2"
                            Margin="0,0,10,0">

                    <TextBlock Text="Detector"
                               Foreground="#B8C0CC"
                               FontSize="12"
                               Margin="2,0,0,5"/>

                    <TextBox Text="{Binding DetectorFilter,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="34"
                             Padding="8,4"
                             Foreground="White"
                             Background="#1F232A"
                             BorderBrush="#4A5360"/>

                </StackPanel>

                <!-- Frame -->
                <StackPanel Grid.Column="3"
                            Margin="0,0,10,0">

                    <TextBlock Text="Frame"
                               Foreground="#B8C0CC"
                               FontSize="12"
                               Margin="2,0,0,5"/>

                    <TextBox Text="{Binding FrameFilter,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="34"
                             Padding="8,4"
                             Foreground="White"
                             Background="#1F232A"
                             BorderBrush="#4A5360"/>

                </StackPanel>

                <!-- Status -->
                <StackPanel Grid.Column="4"
                            Margin="0,0,10,0">

                    <TextBlock Text="Review Status"
                               Foreground="#B8C0CC"
                               FontSize="12"
                               Margin="2,0,0,5"/>

                    <ComboBox ItemsSource="{Binding ReviewStatuses}"
                              SelectedItem="{Binding StatusFilter,
                                                      UpdateSourceTrigger=PropertyChanged}"
                              Height="34"
                              Background="#1F232A"
                              Foreground="White"
                              BorderBrush="#4A5360"
                              Padding="6,2"/>

                </StackPanel>

                <!-- Clear -->
                <Button Grid.Column="5"
                        Content="CLEAR FILTERS"
                        Command="{Binding ClearFilterCommand}"
                        Height="34"
                        Margin="5,20,0,0"
                        Background="#3A424D"
                        Foreground="White"
                        BorderBrush="#5A6470"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>

            </Grid>

        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2"
              Margin="0,12,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Preview Panel -->
            <Border Grid.Column="0"
                    Background="#252B33"
                    CornerRadius="8"
                    Margin="0,0,10,0">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="125"/>
                    </Grid.RowDefinitions>

                    <!-- Image Viewer -->
                    <Border Grid.Row="0"
                            Background="Black"
                            BorderBrush="#404040"
                            BorderThickness="1">

                        <Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="Black"
                                          CanContentScroll="False">

                                <Grid HorizontalAlignment="Center"
                                      VerticalAlignment="Center">

                                    <Image Source="{Binding SelectedImage.FilePath}"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">

                                        <Image.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding ZoomLevel}"
                                                            ScaleY="{Binding ZoomLevel}"/>
                                        </Image.RenderTransform>

                                    </Image>

                                </Grid>

                            </ScrollViewer>

                            <TextBlock Text="NO IMAGE SELECTED"
                                       Foreground="Gray"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">

                                <TextBlock.Style>

                                    <Style TargetType="TextBlock">

                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding SelectedImage}"
                                                         Value="{x:Null}">

                                                <Setter Property="Visibility"
                                                        Value="Visible"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>

                        </Grid>

                    </Border>

                    <!-- Zoom -->
                    <Border Grid.Row="1"
                            Background="#20252C"
                            CornerRadius="6"
                            Margin="0,8,0,0"
                            Padding="8">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="FIT"
                                    Command="{Binding ResetZoomCommand}"
                                    Width="50"
                                    Height="30"
                                    HorizontalAlignment="Left"
                                    Background="#3A424D"
                                    Foreground="White"
                                    BorderBrush="#5A6470"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"/>

                            <Button Grid.Column="1"
                                    Content="−"
                                    Command="{Binding ZoomOutCommand}"
                                    Width="40"
                                    Height="34"
                                    Background="#3A424D"
                                    Foreground="White"
                                    BorderBrush="#5A6470"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Cursor="Hand"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding ZoomLevel,
                                                      StringFormat={}{0:P0}}"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="3"
                                    Content="+"
                                    Command="{Binding ZoomInCommand}"
                                    Width="40"
                                    Height="34"
                                    Background="#3A424D"
                                    Foreground="White"
                                    BorderBrush="#5A6470"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Cursor="Hand"/>

                        </Grid>

                    </Border>

                    <!-- Navigation -->
                    <Border Grid.Row="2"
                            Background="#20252C"
                            CornerRadius="6"
                            Margin="0,8,0,0"
                            Padding="8">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="◀  PREVIOUS"
                                    Command="{Binding PreviousImageCommand}"
                                    IsEnabled="{Binding HasPreviousImage}"
                                    Height="34"
                                    Width="115"
                                    HorizontalAlignment="Left"
                                    Background="#3A424D"
                                    Foreground="White"
                                    BorderBrush="#5A6470"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedImage.FrameNumber,
                                                      StringFormat=FRAME {0},
                                                      TargetNullValue=FRAME —}"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>

                            <Button Grid.Column="2"
                                    Content="NEXT  ▶"
                                    Command="{Binding NextImageCommand}"
                                    IsEnabled="{Binding HasNextImage}"
                                    Height="34"
                                    Width="115"
                                    HorizontalAlignment="Right"
                                    Background="#3A424D"
                                    Foreground="White"
                                    BorderBrush="#5A6470"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"/>

                        </Grid>

                    </Border>

                    <!-- Review Decision -->
                    <Border Grid.Row="3"
                            Background="#20252C"
                            CornerRadius="6"
                            Margin="0,8,0,0"
                            Padding="8">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="REVIEW DECISION"
                                       Foreground="#B8C0CC"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="2,0,0,7"/>

                            <Grid Grid.Row="1">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="ACCEPT"
                                        Command="{Binding AcceptCommand}"
                                        Height="34"
                                        Margin="0,0,4,0"
                                        Background="#315B3A"
                                        Foreground="White"
                                        BorderBrush="#4C8A59"
                                        FontWeight="Bold"
                                        Cursor="Hand"/>

                                <Button Grid.Column="1"
                                        Content="HOLD"
                                        Command="{Binding HoldCommand}"
                                        Height="34"
                                        Margin="4,0"
                                        Background="#66552B"
                                        Foreground="White"
                                        BorderBrush="#9B803D"
                                        FontWeight="Bold"
                                        Cursor="Hand"/>

                                <Button Grid.Column="2"
                                        Content="REJECT"
                                        Command="{Binding RejectCommand}"
                                        Height="34"
                                        Margin="4,0,0,0"
                                        Background="#633535"
                                        Foreground="White"
                                        BorderBrush="#A65353"
                                        FontWeight="Bold"
                                        Cursor="Hand"/>

                            </Grid>

                        </Grid>

                    </Border>

                    <!-- Image Information -->
                    <StackPanel Grid.Row="4"
                                Margin="0,10,0,0">

                        <TextBlock Text="{Binding SelectedImage.JobNumber,
                                                  TargetNullValue=No Image Selected}"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding SelectedImage.Operator}"
                                   Foreground="White"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="{Binding SelectedImage.DetectorName}"
                                   Foreground="White"
                                   Margin="0,3,0,0"/>

                        <TextBlock Text="{Binding SelectedImage.ReviewStatus,
                                                  TargetNullValue=PENDING}"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="{Binding SelectedImage.ReviewedBy}"
                                   Foreground="#B8C0CC"
                                   FontSize="11"
                                   Margin="0,3,0,0"/>

                        <TextBlock Text="{Binding SelectedImage.ReviewedOn}"
                                   Foreground="#B8C0CC"
                                   FontSize="11"
                                   Margin="0,2,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- Records Grid -->
            <Border Grid.Column="1"
                    Background="#252B33"
                    CornerRadius="8">

                <DataGrid ItemsSource="{Binding FilteredImages}"
                          SelectedItem="{Binding SelectedImage}"
                          Margin="10"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Background="#252B33"
                          Foreground="White"
                          BorderBrush="#404752"
                          BorderThickness="1"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Frame"
                                            Binding="{Binding FrameNumber}"
                                            Width="70"/>

                        <DataGridTextColumn Header="Job Number"
                                            Binding="{Binding JobNumber}"
                                            Width="140"/>

                        <DataGridTextColumn Header="Operator"
                                            Binding="{Binding Operator}"
                                            Width="120"/>

                        <DataGridTextColumn Header="kV"
                                            Binding="{Binding KV}"
                                            Width="65"/>

                        <DataGridTextColumn Header="mA"
                                            Binding="{Binding MA}"
                                            Width="65"/>

                        <DataGridTextColumn Header="Exposure"
                                            Binding="{Binding ExposureTime}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Detector"
                                            Binding="{Binding DetectorName}"
                                            Width="130"/>

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding ReviewStatus}"
                                            ElementStyle="{StaticResource ReviewStatusCellStyle}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Captured On"
                                            Binding="{Binding CapturedOn}"
                                            Width="170"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

    </Grid>

</UserControl>