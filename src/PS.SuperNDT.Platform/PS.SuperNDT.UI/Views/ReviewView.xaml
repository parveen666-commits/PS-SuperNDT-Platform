<UserControl x:Class="PS.SuperNDT.UI.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A"
             Focusable="True">

    <UserControl.Resources>

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="Margin"
                    Value="2"/>

            <Setter Property="Padding"
                    Value="9,0"/>

            <Setter Property="Background"
                    Value="#343B46"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#566170"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="10"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>

        <Style x:Key="InfoLabel"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="#8F9AAA"/>

            <Setter Property="FontSize"
                    Value="9"/>

        </Style>

        <Style x:Key="ReviewDataGrid"
               TargetType="DataGrid">

            <Setter Property="Background"
                    Value="#171B20"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#46505C"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="RowBackground"
                    Value="#20252C"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#272D35"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#3A424D"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="#3A424D"/>

            <Setter Property="RowHeight"
                    Value="32"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

        </Style>

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#343B46"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#4B5563"/>

            <Setter Property="BorderThickness"
                    Value="0,0,1,1"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="6,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <Style TargetType="DataGridRow">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#20252C"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#3D5872"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#344252"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style TargetType="DataGridCell">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="5,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <!-- ================================================== -->
        <!-- DARK COMBOBOX ITEM -->
        <!-- ================================================== -->

        <Style x:Key="DarkComboBoxItemStyle"
               TargetType="ComboBoxItem">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#252B33"/>

            <Setter Property="Padding"
                    Value="10,7"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#3D5872"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#4A6A8A"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- ================================================== -->
        <!-- DARK COMBOBOX -->
        <!-- ================================================== -->

        <Style x:Key="DarkComboBox"
               TargetType="ComboBox">

            <Setter Property="Background"
                    Value="#171B20"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#4A5563"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="7,2"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen,
                                                              RelativeSource={RelativeSource TemplatedParent},
                                                              Mode=TwoWay}">

                                <ToggleButton.Template>

                                    <ControlTemplate TargetType="ToggleButton">

                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">

                                            <Grid>

                                                <ContentPresenter
                                                    Margin="9,0,30,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Content="{Binding SelectionBoxItem,
                                                                     RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    ContentTemplate="{Binding SelectionBoxItemTemplate,
                                                                              RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    ContentTemplateSelector="{Binding ItemTemplateSelector,
                                                                                      RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    TextElement.Foreground="White"
                                                    TextElement.FontSize="11"/>

                                                <TextBlock Text="▼"
                                                           Foreground="#B8C0CA"
                                                           FontSize="9"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,9,0"
                                                           IsHitTestVisible="False"/>

                                            </Grid>

                                        </Border>

                                    </ControlTemplate>

                                </ToggleButton.Template>

                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   StaysOpen="True">

                                <Border Background="#252B33"
                                        BorderBrush="#4A5563"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        MinWidth="{Binding ActualWidth,
                                                           RelativeSource={RelativeSource TemplatedParent}}">

                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================================================== -->
        <!-- SEARCH BOX -->
        <!-- ================================================== -->

        <Style x:Key="ReviewSearchBox"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Background"
                    Value="#171B20"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#4A5563"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="9,0"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

    </UserControl.Resources>

    <Grid Margin="12">

        <Grid.RowDefinitions>

            <RowDefinition Height="60"/>

            <RowDefinition Height="94"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- ================================================== -->
        <!-- HEADER -->
        <!-- ================================================== -->

        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="8"
                Padding="16,0">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="80"/>

                    <ColumnDefinition Width="80"/>

                    <ColumnDefinition Width="80"/>

                    <ColumnDefinition Width="80"/>

                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="PIPE IMAGE REVIEW"
                               Foreground="White"
                               FontSize="21"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding ReviewMessage}"
                               Foreground="#9AA5B3"
                               FontSize="10"
                               Margin="0,2,0,0"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="TOTAL"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding TotalImages}"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center">

                    <TextBlock Text="PENDING"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding PendingImages}"
                               Foreground="#FFD45A"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>

                <StackPanel Grid.Column="3"
                            VerticalAlignment="Center">

                    <TextBlock Text="ACCEPTED"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding AcceptedImages}"
                               Foreground="#55D66A"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>

                <StackPanel Grid.Column="4"
                            VerticalAlignment="Center">

                    <TextBlock Text="REJECTED"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding RejectedImages}"
                               Foreground="#FF6B6B"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ================================================== -->
        <!-- FILTER / SEARCH / ZOOM BAR -->
        <!-- ================================================== -->

        <Border Grid.Row="1"
                Background="#252B33"
                CornerRadius="8"
                Margin="0,7,0,0"
                Padding="8">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="38"/>

                    <RowDefinition Height="38"/>

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="210"/>

                    <ColumnDefinition Width="150"/>

                    <ColumnDefinition Width="82"/>

                    <ColumnDefinition Width="82"/>

                    <ColumnDefinition Width="82"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <!-- SEARCH -->

                <TextBox Grid.Row="0"
                         Grid.Column="0"
                         Margin="0,0,8,0"
                         Style="{StaticResource ReviewSearchBox}"
                         Text="{Binding SearchText,
                                        UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search Job, Shot, Pipe, Weld, Operator, Detector..."/>

                <!-- WORK ORDER -->

                <ComboBox Grid.Row="0"
                          Grid.Column="1"
                          Height="34"
                          Margin="0,0,8,0"
                          VerticalContentAlignment="Center"
                          HorizontalContentAlignment="Left"
                          Style="{StaticResource DarkComboBox}"
                          ItemsSource="{Binding WorkOrderItems}"
                          SelectedItem="{Binding SelectedWorkOrder,
                                               Mode=TwoWay}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}">

                    <ComboBox.Resources>

                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"
                                         Color="#252B33"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                                         Color="#252B33"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"
                                         Color="White"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                         Color="#4A6A8A"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                         Color="White"/>

                    </ComboBox.Resources>

                </ComboBox>

                <!-- STATUS -->

                <ComboBox Grid.Row="0"
                          Grid.Column="2"
                          Height="34"
                          Margin="0,0,8,0"
                          VerticalContentAlignment="Center"
                          HorizontalContentAlignment="Left"
                          Style="{StaticResource DarkComboBox}"
                          ItemsSource="{Binding StatusFilterItems}"
                          SelectedItem="{Binding ReviewStatusFilter,
                                               Mode=TwoWay}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}">

                    <ComboBox.Resources>

                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"
                                         Color="#252B33"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                                         Color="#252B33"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"
                                         Color="White"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                         Color="#4A6A8A"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                         Color="White"/>

                    </ComboBox.Resources>

                </ComboBox>

                <Button Grid.Row="0"
                        Grid.Column="3"
                        Content="REFRESH"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ActionButton}"/>

                <Button Grid.Row="0"
                        Grid.Column="4"
                        Content="CLEAR"
                        Command="{Binding ClearFilterCommand}"
                        Style="{StaticResource ActionButton}"/>

                <Button Grid.Row="0"
                        Grid.Column="5"
                        Content="OPEN"
                        Command="{Binding OpenImageCommand}"
                        Style="{StaticResource ActionButton}"/>

                <!-- ZOOM -->

                <StackPanel Grid.Row="0"
                            Grid.Column="6"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="4,0,0,0">

                    <Button Content="−"
                            Width="32"
                            Command="{Binding ZoomOutCommand}"
                            Style="{StaticResource ActionButton}"/>

                    <TextBlock Text="{Binding ZoomLevel,
                                              StringFormat={}{0:0.00}x}"
                               Foreground="White"
                               FontWeight="Bold"
                               Width="48"
                               TextAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Button Content="+"
                            Width="32"
                            Command="{Binding ZoomInCommand}"
                            Style="{StaticResource ActionButton}"/>

                    <Button Content="RESET"
                            Width="56"
                            Command="{Binding ResetZoomCommand}"
                            Style="{StaticResource ActionButton}"/>

                </StackPanel>

                <!-- AI ADD-ON INFORMATION -->

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Background="#20252C"
                        BorderBrush="#46515E"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="9,0"
                        Margin="0,2,8,0">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="AI INTEGRATED"
                                   Foreground="#8FB8FF"
                                   FontWeight="Bold"
                                   FontSize="10"/>

                        <TextBlock Text="  •  PAID ADD-ON"
                                   Foreground="#FFD45A"
                                   FontWeight="Bold"
                                   FontSize="10"/>

                        <TextBlock Text="  |  Automatic Defect Detection"
                                   Foreground="#8F9AAA"
                                   FontSize="10"/>

                    </StackPanel>

                </Border>

                <TextBlock Grid.Row="1"
                           Grid.Column="3"
                           Grid.ColumnSpan="4"
                           Text="{Binding FilteredImages.Count,
                                          StringFormat={}Showing {0} shot(s)}"
                           Foreground="#7F8B99"
                           FontSize="10"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,2,8,0"/>

            </Grid>

        </Border>

        <!-- ================================================== -->
        <!-- MAIN -->
        <!-- ================================================== -->

        <Grid Grid.Row="2"
              Margin="0,8,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="280"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="290"/>

            </Grid.ColumnDefinitions>

            <!-- ================================================== -->
            <!-- SHOT LIST -->
            <!-- ================================================== -->

            <Border Grid.Column="0"
                    Background="#252B33"
                    CornerRadius="8"
                    Margin="0,0,8,0"
                    Padding="7">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="32"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="SHOT LIST"
                                   Foreground="#C5CDD8"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding FilteredImages.Count,
                                                  StringFormat={}Shots: {0}}"
                                   Foreground="#7F8B99"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>

                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FilteredImages}"
                              SelectedItem="{Binding SelectedImage}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              Style="{StaticResource ReviewDataGrid}">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="#"
                                                Binding="{Binding ShotNumber}"
                                                Width="42"/>

                            <DataGridTextColumn Header="POSITION"
                                                Binding="{Binding ShotPosition}"
                                                Width="*"/>

                            <DataGridTextColumn Header="STATUS"
                                                Binding="{Binding ReviewStatus}"
                                                Width="75"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            <!-- ================================================== -->
            <!-- IMAGE VIEWPORT -->
            <!-- ================================================== -->

            <Border Grid.Column="1"
                    Background="#080B0E"
                    BorderBrush="#46515E"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,8,0">

                <Grid>

                    <ScrollViewer x:Name="ImageViewport"
                                  Background="#080B0E"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Focusable="True"
                                  CanContentScroll="False">

                        <Grid x:Name="ImagePanCanvas"
                              Background="Transparent"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">

                            <Grid.RenderTransform>

                                <TransformGroup>

                                    <ScaleTransform
                                        ScaleX="{Binding ZoomLevel}"
                                        ScaleY="{Binding ZoomLevel}"/>

                                    <TranslateTransform/>

                                </TransformGroup>

                            </Grid.RenderTransform>

                            <Border x:Name="ShotFrame"
                                    BorderBrush="#657383"
                                    BorderThickness="1"
                                    Background="#050709"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <Grid>

                                    <Image Source="{Binding DisplayImage}"
                                           Stretch="None"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <Canvas x:Name="DefectOverlayCanvas"
                                            Background="Transparent"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            IsHitTestVisible="True">

                                        <Rectangle x:Name="DefectRectangle"
                                                   Width="0"
                                                   Height="0"
                                                   Stroke="#FF3C3C"
                                                   StrokeThickness="2"
                                                   Fill="#23FF3C3C"
                                                   Visibility="Collapsed"
                                                   IsHitTestVisible="False"/>

                                    </Canvas>

                                    <!-- TOP RULER -->

                                    <Border VerticalAlignment="Top"
                                            Height="30"
                                            Background="#151A20"
                                            BorderBrush="#46515E"
                                            BorderThickness="0,0,0,1"
                                            IsHitTestVisible="False">

                                        <Canvas x:Name="TopRulerCanvas"
                                                Height="30"
                                                Background="Transparent">

                                            <Line X1="0"
                                                  Y1="29"
                                                  X2="0"
                                                  Y2="14"
                                                  Stroke="#D8DEE7"
                                                  StrokeThickness="1"/>

                                            <TextBlock Text="{Binding SelectedImage.ShotStartPosition,
                                                              StringFormat={}{0:0}}"
                                                       Foreground="#E3E8EE"
                                                       FontSize="9"
                                                       Canvas.Left="2"
                                                       Canvas.Top="2"/>

                                            <TextBlock Text="{Binding SelectedImage.ShotEndPosition,
                                                              StringFormat={}{0:0}}"
                                                       Foreground="#E3E8EE"
                                                       FontSize="9"
                                                       HorizontalAlignment="Right"
                                                       Canvas.Right="2"
                                                       Canvas.Top="2"/>

                                        </Canvas>

                                    </Border>

                                    <!-- BOTTOM RULER -->

                                    <Border VerticalAlignment="Bottom"
                                            Height="34"
                                            Background="#151A20"
                                            BorderBrush="#46515E"
                                            BorderThickness="0,1,0,0"
                                            IsHitTestVisible="False">

                                        <Canvas x:Name="RulerCanvas"
                                                Height="34"
                                                Background="Transparent">

                                            <Line X1="0"
                                                  Y1="0"
                                                  X2="0"
                                                  Y2="17"
                                                  Stroke="#D8DEE7"
                                                  StrokeThickness="1"/>

                                            <TextBlock Text="{Binding SelectedImage.ShotStartPosition,
                                                              StringFormat={}{0:0}}"
                                                       Foreground="#E3E8EE"
                                                       FontSize="9"
                                                       Canvas.Left="2"
                                                       Canvas.Top="18"/>

                                            <TextBlock Text="{Binding SelectedImage.ShotEndPosition,
                                                              StringFormat={}{0:0}}"
                                                       Foreground="#E3E8EE"
                                                       FontSize="9"
                                                       Canvas.Right="2"
                                                       Canvas.Top="18"/>

                                        </Canvas>

                                    </Border>

                                </Grid>

                            </Border>

                        </Grid>

                    </ScrollViewer>

                </Grid>

            </Border>

            <!-- ================================================== -->
            <!-- RIGHT SHOT DETAILS -->
            <!-- ================================================== -->

            <Border Grid.Column="2"
                    Background="#252B33"
                    CornerRadius="8"
                    Padding="7">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="32"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="82"/>

                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#343B46"
                            Padding="8,0">

                        <TextBlock Text="SHOT DETAILS"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="11"/>

                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,6">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="105"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>

                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="JOB / WORK ORDER"
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.JobNumber}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="PIPE ID"
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.PipeId}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="SHOT"
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.ShotNumber}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="POSITION"
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.ShotPosition}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Text="SHOT SIZE"
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="4"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.ShotSize}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="5"
                                       Grid.Column="0"
                                       Text="OVERLAP"
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="5"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.Overlap}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="6"
                                       Grid.Column="0"
                                       Text="FRAME"
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="6"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.FrameNumber}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="7"
                                       Grid.Column="0"
                                       Text="WELD NO."
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="7"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.WeldNumber}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="8"
                                       Grid.Column="0"
                                       Text="OPERATOR"
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="8"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.Operator}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="9"
                                       Grid.Column="0"
                                       Text="STATUS"
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="9"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.ReviewStatus}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                        </Grid>

                    </ScrollViewer>

                    <!-- REVIEW ACTIONS + EXPORT -->

                    <StackPanel Grid.Row="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Button Content="ACCEPT"
                                    Width="82"
                                    Height="32"
                                    Command="{Binding ApproveCommand}"
                                    Background="#285B43"
                                    Foreground="White"
                                    BorderBrush="#4D956F"
                                    Margin="3"/>

                            <Button Content="REJECT"
                                    Width="82"
                                    Height="32"
                                    Command="{Binding RejectCommand}"
                                    Background="#703C42"
                                    Foreground="White"
                                    BorderBrush="#B56B73"
                                    Margin="3"/>

                            <Button Content="PENDING"
                                    Width="82"
                                    Height="32"
                                    Command="{Binding PendingCommand}"
                                    Background="#62552B"
                                    Foreground="White"
                                    BorderBrush="#A8954E"
                                    Margin="3"/>

                        </StackPanel>

                        <Button Content="SAVE REVIEWED PNG"
                                Width="262"
                                Height="32"
                                Margin="3,2,3,0"
                                Command="{Binding SaveReviewedPngCommand}"
                                Background="#28506F"
                                Foreground="White"
                                BorderBrush="#5C8FB8"
                                FontWeight="Bold"
                                FontSize="10"
                                ToolTip="Save a reviewed PNG copy without modifying the original image."/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>