<UserControl x:Class="PS.SuperNDT.UI.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <UserControl.Resources>

        <Style x:Key="ActionButton"
               TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#343B46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#566170"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="InfoLabel"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8F9AAA"/>
            <Setter Property="FontSize" Value="9"/>
        </Style>

        <Style x:Key="ReviewDataGrid"
               TargetType="DataGrid">
            <Setter Property="Background" Value="#171B20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#46505C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#20252C"/>
            <Setter Property="AlternatingRowBackground" Value="#272D35"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3A424D"/>
            <Setter Property="VerticalGridLinesBrush" Value="#3A424D"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#343B46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#20252C"/>

            <Style.Triggers>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3D5872"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#344252"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>

            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle"
               TargetType="ComboBoxItem">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#252B33"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D5872"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4A6A8A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="8"
                Padding="16,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="PIPE IMAGE REVIEW"
                               Foreground="White"
                               FontSize="21"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding ReviewMessage}"
                               Foreground="#9AA5B3"
                               FontSize="10"
                               Margin="0,2,0,0"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="TOTAL"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding TotalImages}"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center">

                    <TextBlock Text="PENDING"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding PendingImages}"
                               Foreground="#FFD45A"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>

                <StackPanel Grid.Column="3"
                            VerticalAlignment="Center">

                    <TextBlock Text="ACCEPTED"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding AcceptedImages}"
                               Foreground="#55D66A"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>

                <StackPanel Grid.Column="4"
                            VerticalAlignment="Center">

                    <TextBlock Text="REJECTED"
                               Style="{StaticResource InfoLabel}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding RejectedImages}"
                               Foreground="#FF6B6B"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- FILTER BAR -->

        <Border Grid.Row="1"
                Background="#252B33"
                CornerRadius="8"
                Margin="0,7,0,0"
                Padding="8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Height="34"
                         Margin="0,0,6,0"
                         Padding="9,4"
                         VerticalContentAlignment="Center"
                         Background="#171B20"
                         Foreground="White"
                         BorderBrush="#4A5563"
                         FontSize="12"
                         ToolTip="Search Job, Pipe, Shot, Frame, Operator..."
                         Text="{Binding SearchText,
                                UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox Grid.Column="1"
                          Height="34"
                          Margin="0,0,6,0"
                          Padding="6,3"
                          Background="#171B20"
                          Foreground="White"
                          BorderBrush="#4A5563"
                          BorderThickness="1"
                          ItemsSource="{Binding StatusFilterItems}"
                          SelectedItem="{Binding ReviewStatusFilter,
                                               Mode=TwoWay}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}">

                    <ComboBox.Resources>

                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"
                                         Color="#252B33"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                                         Color="#252B33"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"
                                         Color="White"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                         Color="#3D5872"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                         Color="White"/>

                    </ComboBox.Resources>

                </ComboBox>

                <Button Grid.Column="2"
                        Content="REFRESH"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ActionButton}"/>

                <Button Grid.Column="3"
                        Content="CLEAR"
                        Command="{Binding ClearFilterCommand}"
                        Style="{StaticResource ActionButton}"/>

                <Button Grid.Column="4"
                        Content="OPEN"
                        Command="{Binding OpenImageCommand}"
                        Style="{StaticResource ActionButton}"/>

                <StackPanel Grid.Column="5"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="6,0,0,0">

                    <Button Content="−"
                            Width="34"
                            Command="{Binding ZoomOutCommand}"
                            Style="{StaticResource ActionButton}"/>

                    <TextBlock Text="{Binding ZoomLevel,
                                      StringFormat={}{0:0.00}x}"
                               Foreground="White"
                               FontWeight="Bold"
                               Width="50"
                               TextAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Button Content="+"
                            Width="34"
                            Command="{Binding ZoomInCommand}"
                            Style="{StaticResource ActionButton}"/>

                    <Button Content="RESET"
                            Width="58"
                            Command="{Binding ResetZoomCommand}"
                            Style="{StaticResource ActionButton}"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- MAIN -->

        <Grid Grid.Row="2"
              Margin="0,8,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>


            <!-- SHOT LIST -->

            <Border Grid.Column="0"
                    Background="#252B33"
                    CornerRadius="8"
                    Margin="0,0,8,0"
                    Padding="7">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="44"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="SHOT LIST"
                                   Foreground="#C5CDD8"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding FilteredImages.Count,
                                          StringFormat={}Shots: {0}}"
                                   Foreground="#7F8B99"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>

                    </Grid>


                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FilteredImages}"
                              SelectedItem="{Binding SelectedImage}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              Style="{StaticResource ReviewDataGrid}">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="#"
                                                Binding="{Binding ShotNumber}"
                                                Width="42"/>

                            <DataGridTextColumn Header="POSITION"
                                                Binding="{Binding ShotPosition}"
                                                Width="*"/>

                            <DataGridTextColumn Header="STATUS"
                                                Binding="{Binding ReviewStatus}"
                                                Width="75"/>

                        </DataGrid.Columns>

                    </DataGrid>


                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <Button Content="◀ PREV"
                                Width="80"
                                Command="{Binding PreviousImageCommand}"
                                IsEnabled="{Binding HasPreviousImage}"
                                Style="{StaticResource ActionButton}"/>

                        <Button Content="NEXT ▶"
                                Width="80"
                                Command="{Binding NextImageCommand}"
                                IsEnabled="{Binding HasNextImage}"
                                Style="{StaticResource ActionButton}"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- IMAGE VIEWPORT -->

            <Border Grid.Column="1"
                    Background="#080B0E"
                    BorderBrush="#46515E"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,8,0">

                <Grid>

                    <ScrollViewer x:Name="ImageViewport"
                                  Background="#080B0E"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">

                        <Grid x:Name="ImagePanCanvas"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">

                            <Image Source="{Binding DisplayImage}"
                                   Stretch="None"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <Canvas x:Name="DefectOverlayCanvas"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    IsHitTestVisible="True">

                                <Rectangle x:Name="DefectRectangle"
                                           Width="0"
                                           Height="0"
                                           Stroke="#FF3C3C"
                                           StrokeThickness="2"
                                           Fill="#23FF3C3C"
                                           Visibility="Collapsed"
                                           IsHitTestVisible="False"/>

                            </Canvas>

                        </Grid>

                    </ScrollViewer>

                </Grid>

            </Border>


            <!-- RIGHT DETAILS -->

            <Border Grid.Column="2"
                    Background="#252B33"
                    CornerRadius="8"
                    Padding="7">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="165"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>


                    <Border Grid.Row="0"
                            Background="#343B46"
                            Padding="8,0">

                        <TextBlock Text="SHOT DETAILS"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="11"/>

                    </Border>


                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,6">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="JOB / WORK ORDER"
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.JobNumber}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="PIPE ID"
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.PipeId}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="SHOT"
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.ShotNumber}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="POSITION"
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.ShotPosition}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Text="SHOT SIZE"
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="4"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.ShotSize}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="5"
                                       Grid.Column="0"
                                       Text="OVERLAP"
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="5"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.Overlap}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="6"
                                       Grid.Column="0"
                                       Text="FRAME"
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="6"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.FrameNumber}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="7"
                                       Grid.Column="0"
                                       Text="WELD NO."
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="7"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.WeldNumber}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="8"
                                       Grid.Column="0"
                                       Text="OPERATOR"
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="8"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.Operator}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="9"
                                       Grid.Column="0"
                                       Text="STATUS"
                                       Style="{StaticResource InfoLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="9"
                                       Grid.Column="1"
                                       Text="{Binding SelectedImage.ReviewStatus}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                        </Grid>

                    </ScrollViewer>


                    <!-- REVIEW HISTORY -->

                    <Expander Grid.Row="2"
                              Margin="0,0,0,5"
                              Background="#11161B"
                              BorderBrush="#46515E"
                              BorderThickness="1"
                              IsExpanded="False">

                        <Expander.Header>

                            <TextBlock Text="＋ REVIEW HISTORY"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="Bold"/>

                        </Expander.Header>

                        <Grid Margin="4">

                            <DataGrid ItemsSource="{Binding ReviewHistory}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      Style="{StaticResource ReviewDataGrid}">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="TIME"
                                                        Binding="{Binding Timestamp,
                                                        StringFormat={}{0:dd-MM-yyyy HH:mm}}"
                                                        Width="105"/>

                                    <DataGridTextColumn Header="ACTION"
                                                        Binding="{Binding Action}"
                                                        Width="82"/>

                                    <DataGridTextColumn Header="USER"
                                                        Binding="{Binding Username}"
                                                        Width="75"/>

                                    <DataGridTextColumn Header="DETAIL"
                                                        Binding="{Binding Description}"
                                                        Width="*"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Grid>

                    </Expander>


                    <!-- REVIEW ACTIONS -->

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <Button Content="ACCEPT"
                                Width="82"
                                Height="36"
                                Command="{Binding ApproveCommand}"
                                Background="#285B43"
                                Foreground="White"
                                BorderBrush="#4D956F"
                                Margin="3"/>

                        <Button Content="REJECT"
                                Width="82"
                                Height="36"
                                Command="{Binding RejectCommand}"
                                Background="#703C42"
                                Foreground="White"
                                BorderBrush="#B56B73"
                                Margin="3"/>

                        <Button Content="PENDING"
                                Width="82"
                                Height="36"
                                Command="{Binding PendingCommand}"
                                Background="#62552B"
                                Foreground="White"
                                BorderBrush="#A8954E"
                                Margin="3"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>