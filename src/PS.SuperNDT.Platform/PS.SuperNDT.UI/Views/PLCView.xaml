<UserControl
    x:Class="PS.SuperNDT.UI.Views.PLCView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PS.SuperNDT.UI.Views"
    mc:Ignorable="d"
    d:DesignHeight="900"
    d:DesignWidth="1500">

    <UserControl.Resources>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#252A31"/>
            <Setter Property="BorderBrush" Value="#353B45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F4F7"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AEB6C2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="Background" Value="#1D2127"/>
            <Setter Property="BorderBrush" Value="#414854"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="Background" Value="#1D2127"/>
            <Setter Property="BorderBrush" Value="#414854"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#303640"/>
            <Setter Property="Foreground" Value="#F5F7FA"/>
            <Setter Property="BorderBrush" Value="#4A5260"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#1769AA"/>
            <Setter Property="BorderBrush" Value="#2386D1"/>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FD694"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#303640"/>
            <Setter Property="Foreground" Value="#E9EDF2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#414854"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="#1F232A">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#252A31"
                BorderBrush="#353B45"
                BorderThickness="0,0,0,1"
                Padding="22,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="CONTROL"
                               Foreground="#FFFFFF"
                               FontSize="24"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Pipe positioning and shot acquisition setup"
                               Foreground="#8F98A5"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#18231B"
                        BorderBrush="#315A38"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,7"
                        VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="#69C774"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>

                        <TextBlock Text="CONTROL READY"
                                   Foreground="#9BE2A2"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- SETUP -->
        <Border Grid.Row="1"
                Style="{StaticResource SectionCard}"
                Margin="16,14,16,4">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="PIPE / SHOT SETUP"
                           Style="{StaticResource SectionTitle}"/>

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,12,0">
                        <TextBlock Text="Pipe ID"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Text="{Binding PipeId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,12,0">
                        <TextBlock Text="Weld No."
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Text="{Binding WeldNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="0,0,12,0">
                        <TextBlock Text="Pipe Length (mm)"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Text="{Binding PipeLengthMm, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Margin="0,0,12,0">
                        <TextBlock Text="Shot Length (mm)"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Text="{Binding ShotLengthMm, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4"
                                Margin="0,0,12,0">
                        <TextBlock Text="Overlap (mm)"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Text="{Binding OverlapMm, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5">
                        <TextBlock Text="Step (mm)"
                                   Style="{StaticResource FieldLabel}"/>

                        <Border Height="36"
                                Background="#18231B"
                                BorderBrush="#315A38"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="10,7">

                            <TextBlock Text="{Binding StepLengthMm, StringFormat={}{0:0.###}}"
                                       Foreground="#9BE2A2"
                                       FontWeight="SemiBold"
                                       FontSize="14"/>
                        </Border>
                    </StackPanel>

                </Grid>

                <Grid Grid.Row="2"
                      Margin="0,14,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              Content="Ruler"
                              IsChecked="{Binding RulerEnabled}"
                              Foreground="#D6DCE4"
                              VerticalAlignment="Center"
                              Margin="0,0,22,0"/>

                    <CheckBox Grid.Column="1"
                              Content="Pipe ID Overlay"
                              IsChecked="{Binding PipeIdOverlayEnabled}"
                              Foreground="#D6DCE4"
                              VerticalAlignment="Center"
                              Margin="0,0,22,0"/>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,22,0">

                        <TextBlock Text="Mode:"
                                   Foreground="#8F98A5"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <ComboBox Width="105"
                                  ItemsSource="{Binding AcquisitionModes}"
                                  SelectedItem="{Binding AcquisitionMode}"
                                  Style="{StaticResource FieldCombo}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,22,0">

                        <TextBlock Text="Direction:"
                                   Foreground="#8F98A5"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <ComboBox Width="145"
                                  ItemsSource="{Binding Directions}"
                                  SelectedItem="{Binding Direction}"
                                  Style="{StaticResource FieldCombo}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="4"
                               Text="{Binding PlanSummary}"
                               Foreground="#8F98A5"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="6"
                                Orientation="Horizontal">

                        <Button Content="GENERATE SHOT PLAN"
                                Command="{Binding GenerateShotPlanCommand}"
                                Style="{StaticResource PrimaryButton}"/>

                        <Button Content="CLEAR"
                                Command="{Binding ClearPlanCommand}"
                                Style="{StaticResource ActionButton}"/>
                    </StackPanel>

                </Grid>

            </Grid>
        </Border>

        <!-- SHOT PLAN -->
        <Border Grid.Row="2"
                Style="{StaticResource SectionCard}"
                Margin="16,8,16,4">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="SHOT PLAN"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="0"/>

                        <TextBlock Text="{Binding ProgressText, StringFormat=Progress: {0}}"
                                   Foreground="#8F98A5"
                                   FontSize="12"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#18231B"
                            BorderBrush="#315A38"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12,6"
                            Margin="0,0,8,0">

                        <TextBlock Text="{Binding PlanStatus}"
                                   Style="{StaticResource StatusText}"/>
                    </Border>

                    <Button Grid.Column="2"
                            Content="◀ PREVIOUS"
                            Command="{Binding PreviousShotCommand}"
                            Style="{StaticResource ActionButton}"/>

                    <Button Grid.Column="3"
                            Content="NEXT ▶"
                            Command="{Binding NextShotCommand}"
                            Style="{StaticResource ActionButton}"/>

                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Shots}"
                          SelectedItem="{Binding SelectedShot, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="#1B1F25"
                          Foreground="#E7EBF0"
                          BorderBrush="#353B45"
                          BorderThickness="1"
                          RowBackground="#1B1F25"
                          AlternatingRowBackground="#22272E"
                          HorizontalGridLinesBrush="#303640"
                          VerticalGridLinesBrush="#303640"
                          FontSize="13">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader"
                               BasedOn="{StaticResource DataGridHeader}"/>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="#"
                                            Binding="{Binding ShotNumber}"
                                            Width="55"/>

                        <DataGridTextColumn Header="START (mm)"
                                            Binding="{Binding StartPositionMm, StringFormat={}{0:0.###}}"
                                            Width="110"/>

                        <DataGridTextColumn Header="END (mm)"
                                            Binding="{Binding EndPositionMm, StringFormat={}{0:0.###}}"
                                            Width="110"/>

                        <DataGridTextColumn Header="COVERAGE (mm)"
                                            Binding="{Binding ActualCoverageMm, StringFormat={}{0:0.###}}"
                                            Width="125"/>

                        <DataGridTextColumn Header="OVERLAP (mm)"
                                            Binding="{Binding OverlapMm, StringFormat={}{0:0.###}}"
                                            Width="115"/>

                        <DataGridTextColumn Header="RULER"
                                            Binding="{Binding RulerText}"
                                            Width="160"/>

                        <DataGridTextColumn Header="MODE"
                                            Binding="{Binding AcquisitionMode}"
                                            Width="100"/>

                        <DataGridTextColumn Header="STATUS"
                                            Binding="{Binding Status}"
                                            Width="110"/>

                    </DataGrid.Columns>

                </DataGrid>

                <Grid Grid.Row="2"
                      Margin="0,12,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="{Binding CurrentPositionText}"
                                   Foreground="#D6DCE4"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="   •   "
                                   Foreground="#59616D"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding TotalShots, StringFormat=Total Shots: {0}}"
                                   Foreground="#8F98A5"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding PlanSummary}"
                               Foreground="#697381"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextAlignment="Right"/>

                </Grid>

            </Grid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="3"
                Background="#252A31"
                BorderBrush="#353B45"
                BorderThickness="0,1,0,0"
                Padding="16,10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="CURRENT SHOT"
                               Foreground="#7F8996"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <TextBlock Text="{Binding CurrentShotNumber}"
                               Foreground="#FFFFFF"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="   |   "
                               Foreground="#59616D"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding CurrentPositionText}"
                               Foreground="#B9C1CC"
                               FontSize="12"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="Manual mode available • PLC AUTO integration will be added later"
                           Foreground="#697381"
                           FontSize="11"
                           VerticalAlignment="Center"/>

            </Grid>
        </Border>

    </Grid>

</UserControl>