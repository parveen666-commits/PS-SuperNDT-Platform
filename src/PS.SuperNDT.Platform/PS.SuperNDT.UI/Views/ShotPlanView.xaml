<UserControl x:Class="PS.SuperNDT.UI.Views.ShotPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <UserControl.Resources>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#252A32"/>
            <Setter Property="BorderBrush" Value="#39414C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AEB7C4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#171B20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#46505C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#171B20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#46505C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="0,8,8,0"/>
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="0,8,8,0"/>
            <Setter Property="Background" Value="#303640"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4A5563"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#303640"/>
            <Setter Property="Foreground" Value="#DCE3EB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#414A56"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="SHOT PLAN"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Pipe coverage and acquisition planning"
                           Foreground="#8F9AA8"
                           FontSize="12"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#303640"
                    BorderBrush="#46505C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,7"
                    VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="STATUS"
                               Foreground="#8F9AA8"
                               FontSize="11"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding PlanStatus}"
                               Foreground="#65D391"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

            </Border>
        </Grid>

        <!-- Setup -->
        <Border Grid.Row="1"
                Style="{StaticResource SectionCardStyle}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="PIPE / SHOT SETUP"
                           Style="{StaticResource HeaderTextStyle}"
                           Margin="0,0,0,14"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pipe ID -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Pipe ID"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox Text="{Binding PipeId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Weld -->
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Weld No."
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox Text="{Binding WeldNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Pipe Length -->
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Pipe Length (mm)"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox Text="{Binding PipeLengthMm, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Shot Length -->
                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="Shot Length (mm)"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox Text="{Binding ShotLengthMm, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Overlap -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Overlap (mm)"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox Text="{Binding OverlapMm, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldTextBoxStyle}"/>
                    </StackPanel>

                </Grid>

                <Grid Grid.Row="2"
                      Margin="0,14,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Step -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Step"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <Border Height="34"
                                Background="#171B20"
                                BorderBrush="#39414C"
                                BorderThickness="1"
                                Padding="10,7">

                            <TextBlock Text="{Binding StepLengthMm, StringFormat={}{0:0.###} mm}"
                                       Foreground="#65D391"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Total Shots -->
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Total Shots"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <Border Height="34"
                                Background="#171B20"
                                BorderBrush="#39414C"
                                BorderThickness="1"
                                Padding="10,7">

                            <TextBlock Text="{Binding TotalShots}"
                                       Foreground="White"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Mode -->
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Acquisition Mode"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox SelectedItem="{Binding AcquisitionMode}"
                                  Style="{StaticResource FieldComboBoxStyle}">

                            <ComboBoxItem Content="Manual"/>
                            <ComboBoxItem Content="Auto"/>

                        </ComboBox>
                    </StackPanel>

                    <!-- Direction -->
                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="Direction"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox SelectedItem="{Binding Direction}"
                                  Style="{StaticResource FieldComboBoxStyle}">

                            <ComboBoxItem Content="LeftToRight"/>
                            <ComboBoxItem Content="RightToLeft"/>

                        </ComboBox>
                    </StackPanel>

                    <!-- Current Shot -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Current Shot"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <Border Height="34"
                                Background="#171B20"
                                BorderBrush="#39414C"
                                BorderThickness="1"
                                Padding="10,7">

                            <TextBlock Text="{Binding CurrentShotNumber, StringFormat=Shot {0}}"
                                       Foreground="#FFD166"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                </Grid>

                <Grid Grid.Row="3"
                      Margin="0,14,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ruler -->
                    <CheckBox Grid.Column="0"
                              Content="Ruler on Image"
                              IsChecked="{Binding RulerEnabled}"
                              Foreground="#DCE3EB"
                              VerticalAlignment="Center"
                              Margin="0,0,24,0"/>

                    <!-- Pipe ID -->
                    <CheckBox Grid.Column="1"
                              Content="Pipe ID on Image"
                              IsChecked="{Binding PipeIdOverlayEnabled}"
                              Foreground="#DCE3EB"
                              VerticalAlignment="Center"/>

                    <!-- Generate -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="GENERATE SHOT PLAN"
                                Command="{Binding GenerateShotPlanCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>

                        <Button Content="CLEAR"
                                Command="{Binding ClearPlanCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

        <!-- Shot List -->
        <Border Grid.Row="2"
                Background="#252A32"
                BorderBrush="#39414C"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="4,0,4,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="SHOT PLAN"
                                   Style="{StaticResource HeaderTextStyle}"/>

                        <TextBlock Text="{Binding PlanSummary}"
                                   Foreground="#8F9AA8"
                                   FontSize="11"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressText}"
                               Foreground="#65D391"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Shots}"
                          SelectedItem="{Binding SelectedShot}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="#171B20"
                          Foreground="#DCE3EB"
                          BorderBrush="#39414C"
                          BorderThickness="1"
                          RowBackground="#20252C"
                          AlternatingRowBackground="#1B2026"
                          HorizontalGridLinesBrush="#303640"
                          VerticalGridLinesBrush="#303640"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="SHOT"
                                            Binding="{Binding ShotNumber}"
                                            Width="70"/>

                        <DataGridTextColumn Header="START (mm)"
                                            Binding="{Binding StartPositionMm, StringFormat={}{0:0.###}}"
                                            Width="110"/>

                        <DataGridTextColumn Header="END (mm)"
                                            Binding="{Binding EndPositionMm, StringFormat={}{0:0.###}}"
                                            Width="110"/>

                        <DataGridTextColumn Header="COVERAGE (mm)"
                                            Binding="{Binding ActualCoverageMm, StringFormat={}{0:0.###}}"
                                            Width="120"/>

                        <DataGridTextColumn Header="OVERLAP (mm)"
                                            Binding="{Binding OverlapMm, StringFormat={}{0:0.###}}"
                                            Width="110"/>

                        <DataGridTextColumn Header="RULER"
                                            Binding="{Binding RulerText}"
                                            Width="150"/>

                        <DataGridTextColumn Header="MODE"
                                            Binding="{Binding AcquisitionMode}"
                                            Width="100"/>

                        <DataGridTextColumn Header="STATUS"
                                            Binding="{Binding Status}"
                                            Width="110"/>

                    </DataGrid.Columns>

                </DataGrid>

                <Grid Grid.Row="2"
                      Margin="4,10,4,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding CurrentPositionText}"
                               Foreground="#AEB7C4"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="PREVIOUS SHOT"
                            Command="{Binding PreviousShotCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>

                    <Button Grid.Column="2"
                            Content="NEXT SHOT"
                            Command="{Binding NextShotCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</UserControl>