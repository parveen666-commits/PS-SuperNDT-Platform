<UserControl x:Class="PS.SuperNDT.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="8">

            <TextBlock Text="Reports"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="20,0"/>

        </Border>

        <!-- KPI -->

        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="0,15,0,15">

            <Border Margin="5"
                    Background="#2C313C"
                    CornerRadius="8">

                <StackPanel Margin="15">
                    <TextBlock Text="Total Jobs"
                               Foreground="White"/>
                    <TextBlock Text="{Binding TotalJobs}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#00E5FF"/>
                </StackPanel>

            </Border>

            <Border Margin="5"
                    Background="#2C313C"
                    CornerRadius="8">

                <StackPanel Margin="15">
                    <TextBlock Text="Open Jobs"
                               Foreground="White"/>
                    <TextBlock Text="{Binding OpenJobs}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="Lime"/>
                </StackPanel>

            </Border>

            <Border Margin="5"
                    Background="#2C313C"
                    CornerRadius="8">

                <StackPanel Margin="15">
                    <TextBlock Text="Closed Jobs"
                               Foreground="White"/>
                    <TextBlock Text="{Binding ClosedJobs}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="Orange"/>
                </StackPanel>

            </Border>

            <Border Margin="5"
                    Background="#2C313C"
                    CornerRadius="8">

                <StackPanel Margin="15">
                    <TextBlock Text="Images"
                               Foreground="White"/>
                    <TextBlock Text="{Binding TotalImages}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="Yellow"/>
                </StackPanel>

            </Border>

        </UniformGrid>

        <!-- Data -->

        <Border Grid.Row="2"
                Background="#252B33"
                CornerRadius="8">

            <DataGrid ItemsSource="{Binding Jobs}"
                      AutoGenerateColumns="False"
                      Margin="10"
                      IsReadOnly="True">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Job Number"
                                        Binding="{Binding JobNumber}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Customer"
                                        Binding="{Binding Customer}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Project"
                                        Binding="{Binding Project}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Operator"
                                        Binding="{Binding Operator}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Created"
                                        Binding="{Binding CreatedOn}"
                                        Width="180"/>

                    <DataGridCheckBoxColumn Header="Closed"
                                            Binding="{Binding IsClosed}"
                                            Width="90"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>