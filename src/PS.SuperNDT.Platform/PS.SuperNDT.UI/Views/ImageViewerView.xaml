<UserControl x:Class="PS.SuperNDT.UI.Views.ImageViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="6">

            <Grid Margin="20,0">

                <TextBlock Text="Image Viewer"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Text="{Binding ImageInfo}"
                           Foreground="#B0BEC5"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextAlignment="Right"/>

            </Grid>

        </Border>

        <!-- VIEW AREA -->

        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Background="Black"
                BorderBrush="#404040"
                BorderThickness="1"
                CornerRadius="6">

            <Grid>

                <!-- IMAGE -->

                <Image Source="{Binding CurrentImage.FilePath}"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="20"/>

                <!-- NO IMAGE -->

                <TextBlock Text="NO IMAGE SELECTED"
                           Foreground="Gray"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentImage}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>

                <!-- IMAGE INFORMATION -->

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="20"
                        Width="280"
                        Background="#252B33"
                        CornerRadius="6"
                        Opacity="0.95">

                    <StackPanel Margin="15">

                        <TextBlock Text="Image Information"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding ImageInfo}"
                                   Foreground="#D0D7DE"
                                   FontSize="14"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

    </Grid>

</UserControl>