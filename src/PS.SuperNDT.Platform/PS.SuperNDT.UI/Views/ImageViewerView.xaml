<UserControl x:Class="PS.SuperNDT.UI.Views.ImageViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="6">

            <TextBlock Text="Image Viewer"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="20,0"/>

        </Border>


        <!-- VIEW AREA -->

        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Background="Black"
                BorderBrush="#404040"
                BorderThickness="1"
                CornerRadius="6">

            <Grid>

                <TextBlock Text="NDT IMAGE DISPLAY AREA"
                           Foreground="Gray"
                           FontSize="28"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>


        <!-- IMAGE INFORMATION -->

        <Border Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="20"
                Width="280"
                Background="#252B33"
                CornerRadius="6">

            <TextBlock Text="{Binding ImageInfo}"
                       Foreground="White"
                       FontSize="16"
                       Margin="15"
                       TextWrapping="Wrap"/>

        </Border>

    </Grid>

</UserControl>