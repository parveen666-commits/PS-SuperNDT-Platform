<UserControl x:Class="PS.SuperNDT.UI.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="8">

            <TextBlock Text="Audit Log"
                       Margin="20,0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"/>

        </Border>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,15,0,15">

            <Button Content="Refresh"
                    Width="120"
                    Height="35"
                    Command="{Binding RefreshCommand}"/>

        </StackPanel>

        <Border Grid.Row="2"
                Background="#252B33"
                CornerRadius="8">

            <DataGrid ItemsSource="{Binding Logs}"
                      Margin="10"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Time"
                                        Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                        Width="180"/>

                    <DataGridTextColumn Header="User"
                                        Binding="{Binding Username}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Action"
                                        Binding="{Binding Action}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Module"
                                        Binding="{Binding Module}"
                                        Width="160"/>

                    <DataGridTextColumn Header="Description"
                                        Binding="{Binding Description}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Machine"
                                        Binding="{Binding MachineName}"
                                        Width="180"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>