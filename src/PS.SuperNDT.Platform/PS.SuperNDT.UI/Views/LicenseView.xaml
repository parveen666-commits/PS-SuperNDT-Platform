<UserControl x:Class="PS.SuperNDT.UI.Views.LicenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="20">

        <Border Background="#252B33"
                CornerRadius="10"
                Padding="20"
                MaxWidth="700"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="PS SuperNDT License Manager"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Software Activation"
                           Foreground="#C0C0C0"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,25"/>

                <TextBlock Text="Remaining Trial Days"
                           Foreground="White"
                           FontSize="16"/>

                <TextBlock Text="{Binding RemainingDays}"
                           Foreground="Orange"
                           FontSize="42"
                           FontWeight="Bold"
                           Margin="0,5,0,20"/>

                <TextBlock Text="License Key"
                           Foreground="White"
                           FontSize="16"/>

                <TextBox Height="40"
                         Margin="0,5,0,20"
                         Text="{Binding LicenseKey,
                                        UpdateSourceTrigger=PropertyChanged}"/>

                <Button Content="Activate License"
                        Height="45"
                        Width="220"
                        HorizontalAlignment="Left"
                        Command="{Binding ActivateCommand}"/>

                <Separator Margin="0,25,0,15"/>

                <TextBlock Text="{Binding LicenseStatus}"
                           Foreground="Lime"
                           FontSize="16"
                           FontWeight="SemiBold"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>