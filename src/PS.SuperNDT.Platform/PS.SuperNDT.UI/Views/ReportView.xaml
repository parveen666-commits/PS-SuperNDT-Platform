<UserControl x:Class="PS.SuperNDT.UI.Views.ReportView"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          Background="#1F232A">

   
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Inspection Report"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="White"/>

                <TextBlock Text="{Binding CurrentReport.ReportNumber}"
                       Margin="0,4,0,0"
                       Foreground="#AAB2BD"
                       FontSize="13"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                    Orientation="Horizontal">

                <Button Content="Generate Report"
                    Command="{Binding GenerateReportCommand}"
                    Padding="16,8"
                    Margin="0,0,8,0"/>

                <Button Content="Export PDF"
                    Command="{Binding ExportPdfCommand}"
                    Padding="16,8"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
            Background="#292E36"
            CornerRadius="6"
            Padding="15"
            Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Customer"
                           Foreground="#8F98A3"
                           FontSize="11"/>

                    <TextBlock Text="{Binding CurrentReport.Customer}"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,3,15,0"/>

                    <TextBlock Text="Project"
                           Foreground="#8F98A3"
                           FontSize="11"
                           Margin="0,12,0,0"/>

                    <TextBlock Text="{Binding CurrentReport.Project}"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,3,15,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Component"
                           Foreground="#8F98A3"
                           FontSize="11"/>

                    <TextBlock Text="{Binding CurrentReport.Component}"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,3,15,0"/>

                    <TextBlock Text="Material"
                           Foreground="#8F98A3"
                           FontSize="11"
                           Margin="0,12,0,0"/>

                    <TextBlock Text="{Binding CurrentReport.Material}"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,3,15,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Operator"
                           Foreground="#8F98A3"
                           FontSize="11"/>

                    <TextBlock Text="{Binding CurrentReport.Operator}"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,3,0,0"/>

                    <TextBlock Text="Inspector"
                           Foreground="#8F98A3"
                           FontSize="11"
                           Margin="0,12,0,0"/>

                    <TextBlock Text="{Binding CurrentReport.Inspector}"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
              Margin="0,0,0,8">

                <TextBlock Text="Report Preview"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="White"/>

                <TextBlock Text="{Binding CurrentReport.Result}"
                       HorizontalAlignment="Right"
                       Foreground="#AAB2BD"
                       FontSize="13"/>
            </Grid>

            <Border Grid.Row="1"
                Background="#171A1F"
                BorderBrush="#3A4048"
                BorderThickness="1"
                CornerRadius="6"
                Padding="15">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <TextBlock Text="{Binding GeneratedReport}"
                           Foreground="#D8DCE1"
                           FontSize="13"
                           TextWrapping="Wrap"/>

                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="2"
                   Text="{Binding ExportedFilePath}"
                   Foreground="#7F8995"
                   FontSize="11"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"/>

        </Grid>

    </Grid>
    

</UserControl>
