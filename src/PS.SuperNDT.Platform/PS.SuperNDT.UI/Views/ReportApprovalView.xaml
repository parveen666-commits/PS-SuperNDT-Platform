<UserControl x:Class="PS.SuperNDT.UI.Views.ReportApprovalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border Background="#252B33"
                CornerRadius="8">

            <TextBlock Text="Report Approval"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="20,0"
                       VerticalAlignment="Center"/>

        </Border>


        <Border Grid.Row="1"
                Margin="0,15,0,0"
                Background="#252B33"
                CornerRadius="8"
                Padding="15">


            <StackPanel>


                <DataGrid ItemsSource="{Binding Approvals}"
                          SelectedItem="{Binding SelectedApproval}"
                          AutoGenerateColumns="False"
                          Height="350"
                          IsReadOnly="True">


                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Report Number"
                                            Binding="{Binding ReportNumber}"
                                            Width="180"/>


                        <DataGridTextColumn Header="Level"
                                            Binding="{Binding ApprovalLevel}"
                                            Width="120"/>


                        <DataGridTextColumn Header="Designation"
                                            Binding="{Binding Designation}"
                                            Width="150"/>


                        <DataGridTextColumn Header="Submitted By"
                                            Binding="{Binding SubmittedBy}"
                                            Width="150"/>


                        <DataGridTextColumn Header="Submitted On"
                                            Binding="{Binding SubmittedOn}"
                                            Width="160"/>


                        <DataGridCheckBoxColumn Header="Approved"
                                                Binding="{Binding IsApproved}"
                                                Width="100"/>

                    </DataGrid.Columns>


                </DataGrid>


                <StackPanel Orientation="Horizontal"
                            Margin="0,20,0,0">


                    <Button Content="Approve"
                            Width="120"
                            Height="35"
                            Margin="5"
                            Click="Approve_Click"/>


                    <Button Content="Reject"
                            Width="120"
                            Height="35"
                            Margin="5"
                            Click="Reject_Click"/>


                </StackPanel>


                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="White"
                           Margin="5,15,0,0"/>


            </StackPanel>


        </Border>


    </Grid>

</UserControl>