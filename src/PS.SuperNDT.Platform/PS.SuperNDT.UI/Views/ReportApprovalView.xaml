<UserControl x:Class="PS.SuperNDT.UI.Views.ReportApprovalView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#1F232A"
          Margin="10">

        <Border Background="#252B33"
                CornerRadius="8"
                Padding="20">

            <StackPanel>

                <TextBlock Text="Report Approval Workflow"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Approved By"
                           Foreground="White"/>

                <TextBox Margin="0,5,0,15"
                         Height="32"/>

                <TextBlock Text="Designation"
                           Foreground="White"/>

                <TextBox Margin="0,5,0,15"
                         Height="32"/>

                <TextBlock Text="Remarks"
                           Foreground="White"/>

                <TextBox Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Margin="0,5,0,20"/>

                <Button Content="Approve Report"
                        Width="160"
                        Height="35"
                        HorizontalAlignment="Right"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>