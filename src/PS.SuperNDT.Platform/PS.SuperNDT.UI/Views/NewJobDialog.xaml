<Window x:Class="PS.SuperNDT.UI.Views.NewJobDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Work Order"
        Height="760"
        Width="1050"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#1F232A">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Create New Work Order"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>

                <!-- Work Order Number -->

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Work Order Number"/>

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding JobNumber, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Customer -->

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Customer"/>

                <TextBox Grid.Row="0"
                         Grid.Column="3"
                         Margin="5"
                         Text="{Binding Customer, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Project -->

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Project"/>

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding Project, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Component -->

                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Component"/>

                <TextBox Grid.Row="1"
                         Grid.Column="3"
                         Margin="5"
                         Text="{Binding Component, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Drawing Number -->

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Drawing Number"/>

                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding DrawingNumber, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Purchase Order -->

                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Purchase Order"/>

                <TextBox Grid.Row="2"
                         Grid.Column="3"
                         Margin="5"
                         Text="{Binding PurchaseOrder, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Procedure -->

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Procedure"/>

                <TextBox Grid.Row="3"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding Procedure, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Technique -->

                <TextBlock Grid.Row="3"
                           Grid.Column="2"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Technique"/>

                <TextBox Grid.Row="3"
                         Grid.Column="3"
                         Margin="5"
                         Text="{Binding Technique, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Material -->

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Material"/>

                <TextBox Grid.Row="4"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding Material, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Material Specification -->

                <TextBlock Grid.Row="4"
                           Grid.Column="2"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Material Specification"/>

                <TextBox Grid.Row="4"
                         Grid.Column="3"
                         Margin="5"
                         Text="{Binding MaterialSpecification, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Nominal Thickness -->

                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Nominal Thickness (mm)"/>

                <TextBox Grid.Row="5"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding NominalThicknessMm, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Pipe Diameter -->

                <TextBlock Grid.Row="5"
                           Grid.Column="2"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Pipe Diameter (mm)"/>

                <TextBox Grid.Row="5"
                         Grid.Column="3"
                         Margin="5"
                         Text="{Binding PipeDiameterMm, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Pipe Length -->

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Pipe Length (mm)"/>

                <TextBox Grid.Row="6"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding PipeLengthMm, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Default Shot Size -->

                <TextBlock Grid.Row="6"
                           Grid.Column="2"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Default Shot Size (mm)"/>

                <TextBox Grid.Row="6"
                         Grid.Column="3"
                         Margin="5"
                         Text="{Binding DefaultShotSizeMm, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Default Overlap -->

                <TextBlock Grid.Row="7"
                           Grid.Column="0"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Default Overlap (%)"/>

                <TextBox Grid.Row="7"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding DefaultOverlapPercent, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Weld Number -->

                <TextBlock Grid.Row="7"
                           Grid.Column="2"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Weld Number"/>

                <TextBox Grid.Row="7"
                         Grid.Column="3"
                         Margin="5"
                         Text="{Binding WeldNumber, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Operator -->

                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Operator"/>

                <TextBox Grid.Row="8"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding Operator, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Inspector -->

                <TextBlock Grid.Row="8"
                           Grid.Column="2"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Inspector"/>

                <TextBox Grid.Row="8"
                         Grid.Column="3"
                         Margin="5"
                         Text="{Binding Inspector, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Inspection Standard -->

                <TextBlock Grid.Row="9"
                           Grid.Column="0"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Inspection Standard"/>

                <TextBox Grid.Row="9"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding InspectionStandard, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Acceptance Standard -->

                <TextBlock Grid.Row="9"
                           Grid.Column="2"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Acceptance Standard"/>

                <TextBox Grid.Row="9"
                         Grid.Column="3"
                         Margin="5"
                         Text="{Binding AcceptanceStandard, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Date -->

                <TextBlock Grid.Row="10"
                           Grid.Column="0"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="Date"/>

                <DatePicker Grid.Row="10"
                            Grid.Column="1"
                            Margin="5"
                            SelectedDate="{Binding JobDate}"/>

                <!-- Remarks -->

                <TextBlock Grid.Row="11"
                           Grid.Column="0"
                           Foreground="White"
                           VerticalAlignment="Top"
                           Margin="0,12,0,0"
                           Text="Remarks"/>

                <TextBox Grid.Row="11"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         Height="70"
                         Margin="5"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"/>

            </Grid>

        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Create Work Order"
                    Width="170"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="CreateJob_Click"/>

            <Button Content="Cancel"
                    Width="140"
                    Height="40"
                    Click="Cancel_Click"/>

        </StackPanel>

    </Grid>

</Window>