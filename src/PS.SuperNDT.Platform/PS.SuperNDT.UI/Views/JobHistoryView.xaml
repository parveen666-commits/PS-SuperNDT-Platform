<UserControl x:Class="PS.SuperNDT.UI.Views.JobHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PS.SuperNDT.UI.ViewModels"
             mc:Ignorable="d">

    <UserControl.DataContext>
        <vm:JobHistoryViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>

        <!-- ================================================== -->
        <!-- TEXT -->
        <!-- ================================================== -->

        <Style TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="#F2F5F8"/>

        </Style>

        <Style TargetType="Label">

            <Setter Property="Foreground"
                    Value="#B8C2CE"/>

            <Setter Property="FontSize"
                    Value="10"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>

        <!-- ================================================== -->
        <!-- TEXTBOX -->
        <!-- ================================================== -->

        <Style TargetType="TextBox">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="#0F1317"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

            <Setter Property="CaretBrush"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#596574"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

        <!-- ================================================== -->
        <!-- DARK COMBOBOX ITEM -->
        <!-- ================================================== -->

        <Style x:Key="DarkComboBoxItem"
               TargetType="ComboBoxItem">

            <Setter Property="Background"
                    Value="#171C22"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

            <Setter Property="Padding"
                    Value="10,7"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#34475A"/>

                    <Setter Property="Foreground"
                            Value="#FFFFFF"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#3D5872"/>

                    <Setter Property="Foreground"
                            Value="#FFFFFF"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- ================================================== -->
        <!-- DARK COMBOBOX -->
        <!-- CLOSED BOX + DROPDOWN -->
        <!-- ================================================== -->

        <Style TargetType="ComboBox">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Background"
                    Value="#0F1317"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#596574"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource DarkComboBoxItem}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <!-- ================================== -->
                            <!-- CLOSED BOX -->
                            <!-- ================================== -->

                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen,
                                                              RelativeSource={RelativeSource TemplatedParent},
                                                              Mode=TwoWay}">

                                <ToggleButton.Template>

                                    <ControlTemplate TargetType="ToggleButton">

                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">

                                            <Grid>

                                                <!-- SELECTED VALUE -->

                                                <ContentPresenter
                                                    Margin="9,0,32,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Content="{Binding SelectionBoxItem,
                                                                     RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                    ContentTemplate="{Binding SelectionBoxItemTemplate,
                                                                              RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                    ContentTemplateSelector="{Binding ItemTemplateSelector,
                                                                                      RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                    TextElement.Foreground="#FFFFFF"
                                                    TextElement.FontSize="12"
                                                    IsHitTestVisible="False"/>

                                                <!-- ARROW -->

                                                <TextBlock Text="▼"
                                                           Foreground="#B8C2CE"
                                                           FontSize="9"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,9,0"
                                                           IsHitTestVisible="False"/>

                                            </Grid>

                                        </Border>

                                    </ControlTemplate>

                                </ToggleButton.Template>

                            </ToggleButton>

                            <!-- ================================== -->
                            <!-- DROPDOWN -->
                            <!-- ================================== -->

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   StaysOpen="False">

                                <Border Background="#171C22"
                                        BorderBrush="#596574"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        MinWidth="{Binding ActualWidth,
                                                           RelativeSource={RelativeSource TemplatedParent}}">

                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================================================== -->
        <!-- BUTTON -->
        <!-- ================================================== -->

        <Style TargetType="Button">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Margin"
                    Value="4,0"/>

            <Setter Property="Background"
                    Value="#29323D"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#647180"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#3A4654"/>

                    <Setter Property="BorderBrush"
                            Value="#8D9AAA"/>

                </Trigger>

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter Property="Opacity"
                            Value="0.45"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- ================================================== -->
        <!-- DATAGRID -->
        <!-- ================================================== -->

        <Style TargetType="DataGrid">

            <Setter Property="Background"
                    Value="#0F1317"/>

            <Setter Property="Foreground"
                    Value="#F2F5F8"/>

            <Setter Property="BorderBrush"
                    Value="#46515E"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="RowBackground"
                    Value="#171C22"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#1D232A"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#303943"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="#303943"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

        </Style>

        <!-- ================================================== -->
        <!-- DATAGRID ROW -->
        <!-- ================================================== -->

        <Style TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="#171C22"/>

            <Setter Property="Foreground"
                    Value="#F2F5F8"/>

            <Setter Property="BorderBrush"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#2A333E"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#355A78"/>

                    <Setter Property="Foreground"
                            Value="#FFFFFF"/>

                    <Setter Property="BorderBrush"
                            Value="#76B7E5"/>

                    <Setter Property="BorderThickness"
                            Value="1"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- ================================================== -->
        <!-- DATAGRID CELL -->
        <!-- ================================================== -->

        <Style TargetType="DataGridCell">

            <Setter Property="Foreground"
                    Value="#F2F5F8"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Foreground"
                            Value="#FFFFFF"/>

                    <Setter Property="Background"
                            Value="Transparent"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- ================================================== -->
        <!-- HEADER -->
        <!-- ================================================== -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#29323D"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="BorderBrush"
                    Value="#46515E"/>

            <Setter Property="BorderThickness"
                    Value="0,0,1,1"/>

        </Style>

    </UserControl.Resources>

    <Grid Background="#1F232A"
          Margin="12">

        <Grid.RowDefinitions>

            <RowDefinition Height="58"/>

            <RowDefinition Height="90"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="56"/>

        </Grid.RowDefinitions>

        <!-- ================================================== -->
        <!-- HEADER -->
        <!-- ================================================== -->

        <Grid Grid.Row="0">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="JOB / WORK ORDER HISTORY"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"/>

                <TextBlock Text="Select a Job / Work Order to review its complete shot history"
                           Foreground="#9EAAB7"
                           FontSize="11"
                           Margin="0,4,0,0"/>

            </StackPanel>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#12161B"
                    BorderBrush="#536170"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14,7">

                <TextBlock Text="{Binding TotalJobs,
                                          StringFormat=JOBS : {0}}"
                           Foreground="#FFFFFF"
                           FontSize="12"
                           FontWeight="Bold"/>

            </Border>

        </Grid>

        <!-- ================================================== -->
        <!-- FILTER BAR -->
        <!-- ================================================== -->

        <Border Grid.Row="1"
                Background="#171C22"
                BorderBrush="#46515E"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,4,0,8">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="2.4*"/>

                    <ColumnDefinition Width="1.15*"/>

                    <ColumnDefinition Width="1.15*"/>

                    <ColumnDefinition Width="1.15*"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <!-- SEARCH -->

                <StackPanel Grid.Column="0"
                            Margin="0,0,8,0">

                    <Label Content="SEARCH / FILTER"/>

                    <TextBox Text="{Binding SearchText,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                </StackPanel>

                <!-- STATUS -->

                <StackPanel Grid.Column="1"
                            Margin="0,0,8,0">

                    <Label Content="STATUS FILTER"/>

                    <ComboBox ItemsSource="{Binding StatusItems}"
                              SelectedItem="{Binding SelectedStatus}"
                              Foreground="#FFFFFF"/>

                </StackPanel>

                <!-- CUSTOMER -->

                <StackPanel Grid.Column="2"
                            Margin="0,0,8,0">

                    <Label Content="CUSTOMER FILTER"/>

                    <ComboBox ItemsSource="{Binding CustomerItems}"
                              SelectedItem="{Binding SelectedCustomer}"
                              Foreground="#FFFFFF"/>

                </StackPanel>

                <!-- OPERATOR -->

                <StackPanel Grid.Column="3"
                            Margin="0,0,8,0">

                    <Label Content="OPERATOR FILTER"/>

                    <ComboBox ItemsSource="{Binding OperatorItems}"
                              SelectedItem="{Binding SelectedOperator}"
                              Foreground="#FFFFFF"/>

                </StackPanel>

                <!-- REFRESH -->

                <Button Grid.Column="4"
                        Content="REFRESH"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Bottom"/>

                <!-- CLEAR -->

                <Button Grid.Column="5"
                        Content="CLEAR FILTER"
                        Command="{Binding ClearFilterCommand}"
                        VerticalAlignment="Bottom"/>

            </Grid>

        </Border>

        <!-- ================================================== -->
        <!-- TABLE -->
        <!-- ================================================== -->

        <Border Grid.Row="2"
                Background="#0F1317"
                BorderBrush="#46515E"
                BorderThickness="1"
                CornerRadius="4">

            <DataGrid ItemsSource="{Binding FilteredJobs}"
                      SelectedItem="{Binding SelectedJob,
                                             Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      Margin="1">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="JOB / WORK ORDER"
                                        Binding="{Binding JobNumber}"
                                        Width="150"/>

                    <DataGridTextColumn Header="CUSTOMER"
                                        Binding="{Binding Customer}"
                                        Width="140"/>

                    <DataGridTextColumn Header="PROJECT"
                                        Binding="{Binding Project}"
                                        Width="140"/>

                    <DataGridTextColumn Header="COMPONENT"
                                        Binding="{Binding Component}"
                                        Width="130"/>

                    <DataGridTextColumn Header="WELD NO."
                                        Binding="{Binding WeldNumber}"
                                        Width="100"/>

                    <DataGridTextColumn Header="OPERATOR"
                                        Binding="{Binding Operator}"
                                        Width="110"/>

                    <DataGridTextColumn Header="DATE"
                                        Binding="{Binding CreatedOn,
                                                        StringFormat={}{0:dd-MM-yyyy}}"
                                        Width="105"/>

                    <DataGridTextColumn Header="SHOTS"
                                        Binding="{Binding TotalShots}"
                                        Width="70"/>

                    <DataGridTextColumn Header="ACCEPT"
                                        Binding="{Binding AcceptedShots}"
                                        Width="75"/>

                    <DataGridTextColumn Header="REJECT"
                                        Binding="{Binding RejectedShots}"
                                        Width="75"/>

                    <DataGridTextColumn Header="REPAIR"
                                        Binding="{Binding RepairShots}"
                                        Width="75"/>

                    <DataGridTextColumn Header="PENDING"
                                        Binding="{Binding PendingShots}"
                                        Width="80"/>

                    <DataGridTextColumn Header="STATUS"
                                        Binding="{Binding OverallStatus}"
                                        Width="95"/>

                    <DataGridCheckBoxColumn Header="CLOSED"
                                            Binding="{Binding IsClosed}"
                                            Width="70"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- ================================================== -->
        <!-- FOOTER -->
        <!-- ================================================== -->

        <Grid Grid.Row="3"
              Margin="0,8,0,0">

            <TextBlock VerticalAlignment="Center"
                       Text="Select a Job / Work Order from the table to continue"
                       Foreground="#9EAAB7"
                       FontSize="11"/>

            <Button HorizontalAlignment="Right"
                    Width="160"
                    Height="38"
                    Content="OPEN REVIEW"
                    Command="{Binding OpenReviewCommand}"
                    IsEnabled="{Binding HasSelectedJob}"
                    Background="#2F6F9F"
                    Foreground="#FFFFFF"
                    BorderBrush="#75B9E6"
                    FontSize="12"
                    FontWeight="Bold"
                    Margin="4,0,0,0"/>

        </Grid>

    </Grid>

</UserControl>