<UserControl x:Class="PS.SuperNDT.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#1E1E1E">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="2*"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- Header -->

        <TextBlock
            Margin="20"
            FontSize="28"
            FontWeight="Bold"
            Foreground="White"
            Text="PS SuperNDT Dashboard"/>

        <!-- Dashboard Cards -->

        <UniformGrid Grid.Row="1"
                     Rows="2"
                     Columns="4"
                     Margin="20">

            <Border Margin="10"
                    Background="#2C313C"
                    CornerRadius="10">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        Foreground="White"
                        Text="Detector"/>

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="Lime"
                        Text="READY"/>

                </StackPanel>

            </Border>

            <Border Margin="10"
                    Background="#2C313C"
                    CornerRadius="10">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        Foreground="White"
                        Text="PLC"/>

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="Orange"
                        Text="OFFLINE"/>

                </StackPanel>

            </Border>

            <Border Margin="10"
                    Background="#2C313C"
                    CornerRadius="10">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        Foreground="White"
                        Text="Shots Today"/>

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="0"/>

                </StackPanel>

            </Border>

            <Border Margin="10"
                    Background="#2C313C"
                    CornerRadius="10">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        Foreground="White"
                        Text="Storage"/>

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="100 %"/>

                </StackPanel>

            </Border>

            <Border Margin="10"
                    Background="#2C313C"
                    CornerRadius="10">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        Foreground="White"
                        Text="Accepted"/>

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="Lime"
                        Text="0"/>

                </StackPanel>

            </Border>

            <Border Margin="10"
                    Background="#2C313C"
                    CornerRadius="10">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        Foreground="White"
                        Text="Rejected"/>

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="Red"
                        Text="0"/>

                </StackPanel>

            </Border>

            <Border Margin="10"
                    Background="#2C313C"
                    CornerRadius="10">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        Foreground="White"
                        Text="Database"/>

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="Lime"
                        Text="ONLINE"/>

                </StackPanel>

            </Border>

            <Border Margin="10"
                    Background="#2C313C"
                    CornerRadius="10">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        Foreground="White"
                        Text="License"/>

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="Lime"
                        Text="ACTIVE"/>

                </StackPanel>

            </Border>

        </UniformGrid>

        <!-- Recent Activity -->

        <Border Grid.Row="2"
                Margin="20"
                Background="#2C313C"
                CornerRadius="10">

            <StackPanel Margin="15">

                <TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Recent Activity"/>

                <TextBlock
                    Margin="0,10,0,0"
                    Foreground="LightGray"
                    Text="No inspection started."/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>