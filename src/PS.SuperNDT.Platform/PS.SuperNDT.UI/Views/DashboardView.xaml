<UserControl x:Class="PS.SuperNDT.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#1F232A">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <Border Background="#252B33">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="Dashboard"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="White"
                    VerticalAlignment="Center"/>

                <TextBlock
                    Grid.Column="1"
                    Text="{Binding CurrentTime}"
                    FontSize="18"
                    Foreground="White"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"/>

            </Grid>

        </Border>

        <!-- Cards -->

        <UniformGrid
            Grid.Row="1"
            Margin="20"
            Rows="2"
            Columns="4">

            <!-- Detector -->

            <Border Margin="10"
                    Background="#2C313C"
                    CornerRadius="10">

                <StackPanel Margin="20">

                    <TextBlock
                        Text="Detector"
                        FontSize="18"
                        Foreground="White"/>

                    <TextBlock
                        Margin="0,20,0,0"
                        Text="{Binding DetectorStatus}"
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="Lime"/>

                </StackPanel>

            </Border>

            <!-- PLC -->

            <Border Margin="10"
                    Background="#2C313C"
                    CornerRadius="10">

                <StackPanel Margin="20">

                    <TextBlock
                        Text="PLC"
                        FontSize="18"
                        Foreground="White"/>

                    <TextBlock
                        Margin="0,20,0,0"
                        Text="{Binding PLCStatus}"
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="Orange"/>

                </StackPanel>

            </Border>

            <!-- Recipe -->

            <Border Margin="10"
                    Background="#2C313C"
                    CornerRadius="10">

                <StackPanel Margin="20">

                    <TextBlock
                        Text="Recipe"
                        FontSize="18"
                        Foreground="White"/>

                    <TextBlock
                        Margin="0,20,0,0"
                        Text="{Binding CurrentRecipe}"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="White"/>

                </StackPanel>

            </Border>

            <!-- Job -->

            <Border Margin="10"
                    Background="#2C313C"
                    CornerRadius="10">

                <StackPanel Margin="20">

                    <TextBlock
                        Text="Current Job"
                        FontSize="18"
                        Foreground="White"/>

                    <TextBlock
                        Margin="0,20,0,0"
                        Text="{Binding CurrentJob}"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="White"/>

                </StackPanel>

            </Border>

            <!-- Shots -->

            <Border Margin="10"
                    Background="#2C313C"
                    CornerRadius="10">

                <StackPanel Margin="20">

                    <TextBlock
                        Text="Today's Shots"
                        FontSize="18"
                        Foreground="White"/>

                    <TextBlock
                        Margin="0,20,0,0"
                        Text="{Binding TotalShots}"
                        FontSize="40"
                        FontWeight="Bold"
                        Foreground="#00E5FF"/>

                </StackPanel>

            </Border>

            <!-- Reject -->

            <Border Margin="10"
                    Background="#2C313C"
                    CornerRadius="10">

                <StackPanel Margin="20">

                    <TextBlock
                        Text="Reject"
                        FontSize="18"
                        Foreground="White"/>

                    <TextBlock
                        Margin="0,20,0,0"
                        Text="{Binding RejectCount}"
                        FontSize="40"
                        FontWeight="Bold"
                        Foreground="Red"/>

                </StackPanel>

            </Border>

            <!-- Storage -->

            <Border Margin="10"
                    Background="#2C313C"
                    CornerRadius="10">

                <StackPanel Margin="20">

                    <TextBlock
                        Text="Storage"
                        FontSize="18"
                        Foreground="White"/>

                    <ProgressBar
                        Height="25"
                        Margin="0,20,0,0"
                        Value="{Binding StoragePercent}"
                        Maximum="100"/>

                </StackPanel>

            </Border>

            <!-- Health -->

            <Border Margin="10"
                    Background="#2C313C"
                    CornerRadius="10">

                <StackPanel Margin="20">

                    <TextBlock
                        Text="System Health"
                        FontSize="18"
                        Foreground="White"/>

                    <TextBlock
                        Margin="0,20,0,0"
                        Text="Healthy"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="Lime"/>

                </StackPanel>

            </Border>

        </UniformGrid>

    </Grid>

</UserControl>