<UserControl x:Class="PS.SuperNDT.UI.Views.ReportDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <TextBlock Text="Reporting Dashboard"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="White"/>


        <Button Grid.Row="1"
                Content="Refresh"
                Command="{Binding RefreshCommand}"
                Width="120"
                Height="35"
                HorizontalAlignment="Left"
                Margin="0,15,0,15"/>


        <UniformGrid Grid.Row="2"
                     Rows="2"
                     Columns="3">


            <Border Margin="8"
                    Background="#252B33"
                    CornerRadius="8">

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Total Reports"
                               Foreground="White"
                               FontSize="16"/>

                    <TextBlock Text="{Binding TotalReports}"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>


            <Border Margin="8"
                    Background="#252B33"
                    CornerRadius="8">

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Approved"
                               Foreground="White"
                               FontSize="16"/>

                    <TextBlock Text="{Binding ApprovedReports}"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>


            <Border Margin="8"
                    Background="#252B33"
                    CornerRadius="8">

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Pending"
                               Foreground="White"
                               FontSize="16"/>

                    <TextBlock Text="{Binding PendingReports}"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>


            <Border Margin="8"
                    Background="#252B33"
                    CornerRadius="8">

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Today Reports"
                               Foreground="White"
                               FontSize="16"/>

                    <TextBlock Text="{Binding TodayReports}"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>


            <Border Margin="8"
                    Background="#252B33"
                    CornerRadius="8">

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Findings"
                               Foreground="White"
                               FontSize="16"/>

                    <TextBlock Text="{Binding TotalFindings}"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>


            <Border Margin="8"
                    Background="#252B33"
                    CornerRadius="8">

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Images"
                               Foreground="White"
                               FontSize="16"/>

                    <TextBlock Text="{Binding TotalImages}"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>


        </UniformGrid>

    </Grid>

</UserControl>