<UserControl x:Class="PS.SuperNDT.UI.Views.ReportDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Reporting Dashboard"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="5"/>

        <UniformGrid Grid.Row="1"
                     Rows="2"
                     Columns="3"
                     Margin="0,20,0,0">

            <Border Margin="8"
                    Background="#252B33"
                    CornerRadius="8">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Total Reports"
                               Foreground="White"
                               FontSize="16"/>
                    <TextBlock Text="{Binding TotalReports}"
                               Foreground="#00C853"
                               FontSize="34"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Margin="8"
                    Background="#252B33"
                    CornerRadius="8">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Approved"
                               Foreground="White"
                               FontSize="16"/>
                    <TextBlock Text="{Binding ApprovedReports}"
                               Foreground="#00C853"
                               FontSize="34"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Margin="8"
                    Background="#252B33"
                    CornerRadius="8">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Pending"
                               Foreground="White"
                               FontSize="16"/>
                    <TextBlock Text="{Binding PendingReports}"
                               Foreground="#FFC107"
                               FontSize="34"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Margin="8"
                    Background="#252B33"
                    CornerRadius="8">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Today's Reports"
                               Foreground="White"
                               FontSize="16"/>
                    <TextBlock Text="{Binding TodayReports}"
                               Foreground="#03A9F4"
                               FontSize="34"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Margin="8"
                    Background="#252B33"
                    CornerRadius="8">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Findings"
                               Foreground="White"
                               FontSize="16"/>
                    <TextBlock Text="{Binding TotalFindings}"
                               Foreground="#FF9800"
                               FontSize="34"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Margin="8"
                    Background="#252B33"
                    CornerRadius="8">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Images"
                               Foreground="White"
                               FontSize="16"/>
                    <TextBlock Text="{Binding TotalImages}"
                               Foreground="#9C27B0"
                               FontSize="34"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

        </UniformGrid>

    </Grid>

</UserControl>