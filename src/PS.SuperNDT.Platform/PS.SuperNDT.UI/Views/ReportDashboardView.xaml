<UserControl x:Class="PS.SuperNDT.UI.Views.ReportDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="8">

            <TextBlock Text="Report Dashboard"
                       Margin="20,0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"/>

        </Border>


        <Grid Grid.Row="1"
              Margin="0,15,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Border Grid.Column="0"
                    Background="#252B33"
                    CornerRadius="8"
                    Margin="5"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Total Reports"
                               Foreground="White"
                               FontSize="18"/>

                    <TextBlock Text="{Binding TotalReports}"
                               Foreground="White"
                               FontSize="36"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>


            <Border Grid.Column="1"
                    Background="#252B33"
                    CornerRadius="8"
                    Margin="5"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Approved"
                               Foreground="White"
                               FontSize="18"/>

                    <TextBlock Text="{Binding ApprovedReports}"
                               Foreground="White"
                               FontSize="36"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>


            <Border Grid.Column="2"
                    Background="#252B33"
                    CornerRadius="8"
                    Margin="5"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Pending"
                               Foreground="White"
                               FontSize="18"/>

                    <TextBlock Text="{Binding PendingReports}"
                               Foreground="White"
                               FontSize="36"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>


            <Border Grid.Column="3"
                    Background="#252B33"
                    CornerRadius="8"
                    Margin="5"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Images"
                               Foreground="White"
                               FontSize="18"/>

                    <TextBlock Text="{Binding TotalImages}"
                               Foreground="White"
                               FontSize="36"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>


        </Grid>

    </Grid>

</UserControl>