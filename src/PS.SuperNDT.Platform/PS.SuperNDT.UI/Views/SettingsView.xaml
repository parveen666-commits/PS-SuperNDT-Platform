<UserControl x:Class="PS.SuperNDT.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1F232A">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <Border Grid.Row="0"
                Background="#252B33"
                CornerRadius="8">

            <TextBlock Text="Settings"
                       Margin="20,0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"/>

        </Border>

        <!-- Content -->

        <ScrollViewer Grid.Row="1"
                      Margin="0,15,0,0"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- Database -->

                <Border Background="#252B33"
                        CornerRadius="8"
                        Margin="0,0,0,10">

                    <StackPanel Margin="20">

                        <TextBlock Text="Database"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Database File Path"
                                   Foreground="White"
                                   Margin="0,15,0,5"/>

                        <TextBox Text="{Binding DatabasePath}"
                                 Height="35"/>

                    </StackPanel>

                </Border>

                <!-- Storage -->

                <Border Background="#252B33"
                        CornerRadius="8"
                        Margin="0,0,0,10">

                    <StackPanel Margin="20">

                        <TextBlock Text="Image Storage"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Storage Folder"
                                   Foreground="White"
                                   Margin="0,15,0,5"/>

                        <TextBox Text="{Binding StoragePath}"
                                 Height="35"/>

                    </StackPanel>

                </Border>

                <!-- Detector -->

                <Border Background="#252B33"
                        CornerRadius="8"
                        Margin="0,0,0,10">

                    <StackPanel Margin="20">

                        <TextBlock Text="Detector"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                        <CheckBox Content="Auto Connect Detector"
                                  IsChecked="{Binding AutoConnectDetector}"
                                  Foreground="White"
                                  Margin="0,15,0,0"/>

                        <CheckBox Content="Enable Image Preview"
                                  IsChecked="{Binding EnableImagePreview}"
                                  Foreground="White"
                                  Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

                <!-- PLC -->

                <Border Background="#252B33"
                        CornerRadius="8"
                        Margin="0,0,0,10">

                    <StackPanel Margin="20">

                        <TextBlock Text="PLC"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                        <CheckBox Content="Auto Connect PLC"
                                  IsChecked="{Binding AutoConnectPlc}"
                                  Foreground="White"
                                  Margin="0,15,0,0"/>

                        <TextBlock Text="PLC IP Address"
                                   Foreground="White"
                                   Margin="0,15,0,5"/>

                        <TextBox Text="{Binding PlcIpAddress}"
                                 Height="35"/>

                    </StackPanel>

                </Border>

                <!-- Theme -->

                <Border Background="#252B33"
                        CornerRadius="8">

                    <StackPanel Margin="20">

                        <TextBlock Text="Appearance"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                        <CheckBox Content="Dark Theme"
                                  IsChecked="{Binding DarkTheme}"
                                  Foreground="White"
                                  Margin="0,15,0,0"/>

                        <Button Content="Save Settings"
                                Width="180"
                                Height="45"
                                Margin="0,20,0,0"
                                Command="{Binding SaveCommand}"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>